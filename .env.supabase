# ============================================
# SUPABASE DATABASE (TEMPLATE - REPLACE WITH YOUR VALUES)
# ============================================
USE_SUPABASE=true

# Supabase Project
SUPABASE_URL=https://your-project-id.supabase.co

# API Keys
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Database Direct Connection (PostgreSQL)
SUPABASE_DB_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# ============================================
# AI PROVIDER API KEYS (REPLACE WITH YOUR VALUES)
# ============================================
ANTHROPIC_API_KEY=sk-ant-your-key-here
DEEPSEEK_API_KEY_1=sk-your-deepseek-key-here
OPENAI_API_KEY=sk-proj-your-openai-key-here

# ============================================
# GOOGLE OAUTH & CLOUD (REPLACE WITH YOUR VALUES)
# ============================================
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret-here
GOOGLE_OAUTH_REDIRECT_URI=https://your-app.onrender.com/oauth2callback
GOOGLE_REDIRECT_URI=https://your-app.onrender.com/api/auth/google/callback
GOOGLE_CLOUD_PROJECT=your-project-name
SERVICE_ACCOUNT_EMAIL=your-service-account@appspot.gserviceaccount.com
GOOGLE_APPLICATION_CREDENTIALS=/data/your-service-account-file.json

# ============================================
# MICROSOFT OAUTH (REPLACE WITH YOUR VALUES)
# ============================================
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=https://your-app.onrender.com/api/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

# ============================================
# FLASK SECURITY
# ============================================
SECRET_KEY=7466add577aefb38e7ab6c849d7742d89ccf10f53eddb04ae470c1451142158d
JWT_SECRET=7466add577aefb38e7ab6c849d7742d89ccf10f53eddb04ae470c1451142158d

# ============================================
# INSTRUCTIONS:
# ============================================
# 1. Go to: https://app.supabase.com/project/_/settings/api
# 2. Copy "Project URL" → paste into SUPABASE_URL
# 3. Copy "anon public" key → paste into SUPABASE_ANON_KEY
# 4. Copy "service_role" key → paste into SUPABASE_SERVICE_KEY
