{
  "platform": "quote_calculator",
  "description": "InHouse Print quote calculator tools - Calculate pricing with GOD (database-driven) and Shopify (hardcoded) calculators for business cards, flyers, booklets, perfect bound books, letterheads, and corflute signs",
  "tools": [
    {
      "name": "calculate_business_cards",
      "description": "Calculate quote for business cards. Returns total price, per-card cost, stock details, and turnaround time. Standard size is 90x55mm.",
      "platform": "quote_calculator",
      "parameters": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "description": "Number of business cards to print (minimum: 50, maximum: 10000)"
          },
          "stock_type": {
            "type": "string",
            "enum": [
              "standard",
              "premium"
            ],
            "description": "Paper stock type - 'standard' (350GSM Satin) or 'premium' (400GSM Satin)"
          },
          "sides": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "Number of printed sides (1 for single-sided, 2 for double-sided)"
          }
        },
        "required": [
          "quantity",
          "stock_type",
          "sides"
        ]
      },
      "returns": {
        "type": "object",
        "description": "Quote result with total_price, per_unit_price, stock_details, turnaround_days"
      },
      "examples": [
        {
          "description": "Quote for 1000 double-sided premium business cards",
          "parameters": {
            "quantity": 1000,
            "stock_type": "premium",
            "sides": 2
          }
        }
      ]
    },
    {
      "name": "calculate_flyers",
      "description": "Calculate quote for flyers/leaflets. Supports multiple sizes (A6, DL, A5, A4) and paper stocks. Returns pricing breakdown.",
      "platform": "quote_calculator",
      "parameters": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "description": "Number of flyers to print"
          },
          "size": {
            "type": "string",
            "enum": [
              "A6",
              "DL",
              "A5",
              "A4"
            ],
            "description": "Flyer size - A6 (105x148mm), DL (99x210mm), A5 (148x210mm), A4 (210x297mm)"
          },
          "stock": {
            "type": "string",
            "description": "Paper stock (e.g. '150GSM Gloss', '250GSM Satin', '300GSM Uncoated'). Use get_stock_list to see available stocks."
          },
          "sides": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "Number of printed sides (1 or 2)"
          }
        },
        "required": [
          "quantity",
          "size",
          "stock",
          "sides"
        ]
      },
      "returns": {
        "type": "object",
        "description": "Quote with total_price, per_unit_price, stock_details"
      }
    },
