    {
      "name": "get_stock_list",
      "description": "Get list of all available paper stocks with specifications. Returns stock name, GSM weight, finish type, and pricing multipliers. Use this BEFORE calculating quotes to see available stock options.",
      "platform": "quote_calculator",
      "parameters": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "all",
              "gloss",
              "satin",
              "uncoated",
              "specialty"
            ],
            "description": "Filter stocks by category (optional, defaults to 'all')"
          }
        },
        "required": []
      },
      "returns": {
        "type": "array",
        "description": "List of stock objects with: name, gsm, finish, suitable_for, price_multiplier"
      },
      "examples": [
        {
          "description": "Get all available stocks",
          "parameters": {
            "category": "all"
          }
        }
      ]
    },
    {
      "name": "calculate_flyers_god",
      "description": "GOD (database-driven) flyer calculator - Most accurate pricing using live database. Supports custom sizes, folding, cellophane lamination. Use for complex quotes or when database accuracy is critical.",
      "platform": "quote_calculator",
      "parameters": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "description": "Number of flyers to print (minimum: 1)"
          },
          "width": {
            "type": "integer",
            "description": "Finished width in mm (e.g., 210 for A4 width)"
          },
          "height": {
            "type": "integer",
            "description": "Finished height in mm (e.g., 297 for A4 height)"
          },
          "gsm": {
            "type": "integer",
            "description": "Paper weight in GSM (e.g., 150, 250, 300)"
          },
          "print_side1": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ],
            "description": "Print mode for side 1: 0=none, 1=colour, 2=b&w, 3=b&w on colour (default: 1)"
          },
          "print_side2": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ],
            "description": "Print mode for side 2: 0=none, 1=colour, 2=b&w, 3=b&w on colour (default: 0)"
          },
          "folding_required": {
            "type": "boolean",
            "description": "Whether folding is required (default: false)"
          },
          "folding_passes": {
            "type": "integer",
            "description": "Number of folds: 1=half fold, 2=z-fold, 3=gate fold (default: 1)"
          },
          "cello_required": {
            "type": "boolean",
            "description": "Whether cellophane lamination required (default: false)"
          },
          "cello_side1": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "description": "Cello type for side 1: 0=none, 1=gloss, 2=matt (default: 0)"
          },
          "cello_side2": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "description": "Cello type for side 2: 0=none, 1=gloss, 2=matt (default: 0)"
          }
        },
        "required": [
          "quantity",
          "width",
          "height",
          "gsm"
        ]
      },
      "returns": {
        "type": "object",
        "description": "QuoteResult with cost_to_business, profit_margin, total_cost_ex_gst, total_cost_inc_gst, breakdown, specifications"
      },
      "examples": [
        {
          "description": "A4 flyer, 250GSM, full colour both sides",
          "parameters": {
            "quantity": 1000,
            "width": 210,
            "height": 297,
            "gsm": 250,
            "print_side1": 1,
            "print_side2": 1
          }
        }
      ]
