    "visible_if_f4_satin": "(F4 == '250GSM Satin') || (F4 == '300GSM Satin') || (F4 == '350GSM Satin')",
    "visible_if_f8_satin": "(F8 == '250GSM Satin') || (F8 == '300GSM Satin') || (F8 == '350GSM Satin')"
  },
  "calculation_formula": {
    "description": "Exact Shopify DPO JavaScript formula implementation",
    "steps": [
      "1. Calculate artwork costs: _a = artworks * 15, _a2 = max(0, _a - 15)",
      "2. Calculate front cover costs: outFront + totalFrontCoverCost + FrontcelloCost",
      "3. Calculate back cover costs: outBack + totalBackCoverCost + BackcelloCost", 
      "4. Calculate content costs: totalContentCost",
      "5. Calculate binding costs: priceofwire (based on thickness tiers)",
      "6. Calculate punch costs: punchPrice",
      "7. Calculate cutting costs: cuttingCost",
      "8. Sum business cost: BizCost = all costs + setup + per-book labor",
      "9. Apply profit margin (tiered based on BizCost)",
      "10. Apply GST: subTotal * 1.15 + 44"
    ]
  }
