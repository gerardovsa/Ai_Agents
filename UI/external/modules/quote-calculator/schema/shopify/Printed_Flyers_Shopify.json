  "calculation_formula": {
    "step_1": {
      "name": "Calculate artwork setup cost",
      "description": "Additional artwork charges after the first",
      "formula": "IF artworks > 1 THEN (artworks * extra_artwork_cost) - extra_artwork_cost ELSE 0",
      "example": "artworks=3 → (3 * $15) - $15 = $30"
    },
    
    "step_2": {
      "name": "Calculate total setup cost",
      "description": "Sum of all setup costs",
      "formula": "setup_total = imposition_setup + guillotine_setup + artwork_setup_cost",
      "example": "$15 + $12 + $30 = $57"
    },
    
    "step_3": {
      "name": "Calculate sheets needed",
      "description": "Total sheets required including waste",
      "formula": "sheets_needed = (quantity / items_per_sheet) * stock_waste_multiplier",
      "example": "(1000 / 4) * 1.05 = 262.5 sheets"
    },
    
    "step_4": {
      "name": "Calculate stock cost",
      "description": "Cost of paper stock",
      "formula": "stock_cost = (sheets_needed / 1000) * price_per_1000_sheets",
      "example": "(262.5 / 1000) * $54 = $14.18"
    },
    
    "step_5": {
      "name": "Calculate click cost",
      "description": "Digital printing cost per sheet",
      "formula": "click_cost = sheets_needed * sides_multiplier * price_per_sheet",
      "example": "262.5 * 1 * $0.044 = $11.55"
    },
    
    "step_6": {
      "name": "Calculate cutting cost",
      "description": "Guillotine cutting cost per block",
      "formula": "cutting_cost = (sheets_needed / cutting_block_size) * cutting_cost_per_block",
      "example": "(262.5 / 500) * $11 = $5.78"
    },
    
    "step_7": {
      "name": "Calculate subtotal",
      "description": "Sum of all costs before margin",
      "formula": "subtotal = setup_total + stock_cost + click_cost + cutting_cost",
      "example": "$57 + $14.18 + $11.55 + $5.78 = $88.51"
    },
    
    "step_8": {
      "name": "Determine profit margin tier",
      "description": "Lookup margin multiplier based on subtotal value",
      "formula": "margin_multiplier = lookup(profit_margin_tiers, subtotal)",
      "example": "subtotal=$88.51 → tier 3 → margin=1.35 (135% markup)"
    },
    
    "step_9": {
      "name": "Calculate total before GST",
      "description": "Apply profit margin to subtotal",
      "formula": "total_before_gst = subtotal + (subtotal * margin_multiplier)",
      "example": "$88.51 + ($88.51 * 1.35) = $207.99"
    },
    
    "step_10": {
      "name": "Apply GST",
      "description": "Add 10% Australian GST",
      "formula": "total_with_gst = total_before_gst * gst_rate",
      "example": "$207.99 * 1.10 = $228.79"
    },
    
    "step_11": {
      "name": "Apply quantity discount",
      "description": "10% discount for orders >= 1000 quantity",
      "formula": "IF quantity >= 1000 THEN total_with_gst * 0.90 ELSE total_with_gst",
      "example": "quantity=1000 → $228.79 * 0.90 = $205.91"
    },
    
    "step_12": {
      "name": "Calculate per unit price",
      "description": "Final price divided by quantity",
      "formula": "price_per_unit = final_total / quantity",
      "example": "$205.91 / 1000 = $0.206 per flyer"
    }
  },
  
