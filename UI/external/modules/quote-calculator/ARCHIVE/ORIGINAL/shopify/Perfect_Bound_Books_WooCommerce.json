  "parameter_mapping": {
    "note": "Map WooCommerce fields to Python calculator parameters",
    "quantity": "F1 → quantity",
    "printed_pages": "F2 → pages",
    "proof_requirements": "F3 → (adds $40 if Physical Unbound Proof selected)",
    "cover_stock": "F4 → cover_stock_gsm (extract GSM value) + cover_stock_type_id (map stock type)",
    "cover_print_type": "F5 → cover_print_mode (1=color, 2=b&w)",
    "celloglaze": "F6 → cello_type (0=none, 1=gloss, 2=matt, 3=soft touch)",
    "finish_size": "F8 → book_width + book_height (extract dimensions)",
    "content_print_type": "F10 → internal_print_mode (1=color, 2=b&w)",
    "content_stock_type": "F11 → internal_stock_gsm (extract GSM) + stock_type_id (map stock type)",
    "stock_type_mapping": {
