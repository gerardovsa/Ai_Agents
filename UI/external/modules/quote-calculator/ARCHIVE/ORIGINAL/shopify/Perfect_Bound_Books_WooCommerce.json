  "calculation_formula": {
    "description": "Exact WooCommerce Perfect Bound Books formula implementation",
    "steps": [
      "1. Calculate setup costs: impos_setup + guilo_setup + binder_setup + cello_setup (if applicable)",
      "2. Calculate cover sheets needed: quantity * stock_waste",
      "3. Calculate cover stock cost: cover_sheets * cover_stock.price",
      "4. Calculate cover click cost: cover_sheets * cover_print_type.price",
      "5. Calculate cello cost (if applicable): cover_sheets * celloglaze.price",
      "6. Calculate total cover cost: cover_stock + cover_clicks + cello",
      "7. Calculate content sheets: (quantity * printed_pages / finish_size.imposition) * stock_waste",
      "8. Calculate content stock cost: content_sheets * content_stock_type.price",
      "9. Calculate content click cost: content_sheets * content_print_type.price",
      "10. Calculate total content cost: content_stock + content_clicks",
      "11. Calculate total sheets printed: content_sheets + cover_sheets",
      "12. Calculate cutting cost: (total_sheets / cutting_block) * cut_cost",
      "13. Calculate binding cost per book from quantity tiers",
      "14. Calculate bind run cost: quantity * (bind_cost_per_book + trimmer_per_book)",
      "15. Calculate BizCost (business cost): setup + cover + content + cutting + binding + proof",
      "16. Determine profit margin tier based on BizCost (NOT quantity)",
      "17. Calculate SubTotal: BizCost + (BizCost * profit_margin)",
      "18. Calculate extra books cost: (SubTotal / quantity) * extra_books_qty",
      "19. Calculate Total: (SubTotal + extra_books_cost) * GST_rate",
      "20. Final price includes all costs + margin + GST"
    ],
    "key_differences_from_wire_spiral": {
      "gst": "10% GST only (no 15% rate, no $44 surcharge like Wire/Spiral)",
      "binding_cost": "Quantity-based tiers for perfect binding (not thickness-based like Wire/Spiral)",
      "cover_structure": "Single cover (not layered PVC + Printed + Cello structure)",
      "profit_margin_basis": "Based on BizCost value, not quantity",
      "setup_costs": "Higher imposition setup ($50 vs $15 for Wire/Spiral)"
    }
  },
