      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Filter by stock category",
            "enum": ["digital", "rigid", "roll", "all"],
            "default": "all"
          },
          "include_inactive": {
            "type": "boolean",
            "description": "Include inactive/discontinued stocks",
            "default": false
          }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {"type": "boolean"},
          "stocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stock_id": {"type": "integer"},
                "stock_name": {"type": "string"},
                "gsm": {"type": "integer"},
                "width": {"type": "number"},
                "length": {"type": "number"},
                "cost_per_thousand": {"type": "number"},
                "category": {"type": "string"},
                "is_active": {"type": "boolean"}
              }
            }
          },
          "total": {"type": "integer"}
        }
      },
