{
  "category": "calculator",
  "version": "1.0.0",
  "tools": [
    {
      "name": "quote_calc_business_cards",
      "description": "Calculate quote for business card printing (1,000 - 10,000 cards). Returns total price including GST, per-unit cost, detailed cost breakdown, and turnaround time. Uses Shopify pricing (no database required).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "description": "Number of business cards to print",
            "minimum": 1000,
            "maximum": 10000,
            "enum": [1000, 2000, 3000, 5000, 10000]
          },
          "stock_type": {
            "type": "string",
            "description": "Paper stock type",
            "enum": ["350gsm_satin", "400gsm_uncoated", "350gsm_gloss"],
            "default": "350gsm_satin"
          },
          "finish": {
            "type": "string",
            "description": "Cellophane finish type (none = no finish)",
            "enum": ["none", "gloss_cello", "matt_cello"],
            "default": "none"
          },
          "print_sides": {
            "type": "string",
            "description": "Single or double-sided printing",
            "enum": ["single", "double"],
            "default": "double"
          }
        },
        "required": ["quantity"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {"type": "boolean"},
          "total_inc_gst": {
            "type": "number",
            "description": "Total price including 10% GST"
          },
          "price_per_unit": {
            "type": "number",
            "description": "Cost per individual business card"
          },
          "turnaround": {
            "type": "string",
            "description": "Expected turnaround time (e.g., '3-5 business days')"
          },
          "breakdown": {
            "type": "object",
            "description": "Detailed cost breakdown",
            "properties": {
              "paper_cost": {"type": "number"},
              "print_cost": {"type": "number"},
              "cello_cost": {"type": "number"},
              "cutting_cost": {"type": "number"},
              "subtotal": {"type": "number"},
              "gst": {"type": "number"}
            }
          }
        }
      },
      "examples": [
        {
          "input": {
            "quantity": 1000,
            "stock_type": "350gsm_satin",
            "finish": "gloss_cello",
            "print_sides": "double"
          },
          "output": {
            "success": true,
            "total_inc_gst": 156.20,
            "price_per_unit": 0.156,
            "turnaround": "3-5 business days",
            "breakdown": {
              "paper_cost": 45.00,
              "print_cost": 60.00,
              "cello_cost": 30.00,
              "cutting_cost": 7.00,
              "subtotal": 142.00,
              "gst": 14.20
            }
          }
        }
      ],
      "backend": {
        "file": "shopify_calculators/business_card_calculator_shopify.py",
        "class": "ShopifyBusinessCardCalculator",
        "method": "calculate"
      },
      "api": {
        "endpoint": "/api/quote-calculator/business-cards",
        "method": "POST"
      },
      "metadata": {
        "category": "printing",
        "databaseRequired": false,
        "estimatedResponseTime": "< 100ms",
        "costPerCall": "free"
      }
    },
    
