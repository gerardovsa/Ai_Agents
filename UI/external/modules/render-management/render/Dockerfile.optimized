# ============================================
# MustCare ValorAISynergySuite V3 - Render.com Deployment
# OPTIMIZED: Faster build with reduced parallel stages
# ============================================

# ============================================
# Stage 1: Frontend Build
# ============================================
FROM node:20-slim AS frontend-builder

WORKDIR /app/frontend

# Install build dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy frontend package files
COPY frontend/package*.json ./

# Install frontend dependencies
RUN npm install --legacy-peer-deps

# Copy frontend source
COPY frontend/ ./

# Build frontend (Vite production build)
RUN npm run build

# Verify build output
RUN ls -la dist/

# ============================================
# Stage 2: Final Production Image
# ============================================
FROM node:20-slim

# Install runtime dependencies including Python
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Setup server first
WORKDIR /app/server
COPY server/package*.json ./
RUN npm install --only=production --legacy-peer-deps
COPY server/ ./

# Copy frontend build output to server/public
COPY --from=frontend-builder /app/frontend/dist ./public

# Generate Prisma Client
RUN npx prisma generate

# Setup collector
WORKDIR /app/collector
COPY collector/package*.json ./
RUN npm install --legacy-peer-deps
COPY collector/ ./

# Back to app root
WORKDIR /app

# Create storage directories
RUN mkdir -p /app/storage/lancedb \
    /app/storage/documents \
    /app/storage/vector-cache \
    /app/storage/uploads \
    /app/storage/logs

# Copy start script
COPY render/start.sh ./start.sh
RUN chmod +x ./start.sh

# Expose ports (Render uses PORT env var, default 10000)
EXPOSE 10000 8888

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-10000}/api/v1/system/check || exit 1

# Environment variables
ENV NODE_ENV=production
ENV PORT=10000
ENV SERVER_PORT=10000
ENV COLLECTOR_PORT=8888

# Start application
CMD ["./start.sh"]
