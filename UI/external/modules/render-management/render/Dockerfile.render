# ============================================
# MustCare ValorAISynergySuite V3 - Render.com Deployment
# Multi-stage Docker build for AnythingLLM with Claude 4 integration
# ============================================

# ============================================
# Stage 1: Frontend Build
# ============================================
FROM node:20-slim AS frontend-builder

WORKDIR /app/frontend

# Install build dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy frontend package files
COPY frontend/package*.json ./

# Install frontend dependencies
RUN npm install --legacy-peer-deps

# Copy frontend source
COPY frontend/ ./

# Build frontend (Vite production build)
RUN npm run build

# Verify build output
RUN ls -la dist/

# ============================================
# Stage 2: Server Build
# ============================================
FROM node:20-slim AS server-builder

WORKDIR /app/server

# Install build dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy server package files
COPY server/package*.json ./

# Install server dependencies (production only)
RUN npm install --only=production --legacy-peer-deps

# Copy server source
COPY server/ ./

# ============================================
# Stage 3: Collector Build
# ============================================
FROM node:20-slim AS collector-builder

WORKDIR /app/collector

# Install build dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy collector package files
COPY collector/package*.json ./

# Install collector dependencies
RUN npm install --legacy-peer-deps

# Copy collector source
COPY collector/ ./

# ============================================
# Stage 4: Final Production Image
# ============================================
FROM node:20-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy built frontend from frontend-builder
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# Copy server with dependencies from server-builder
COPY --from=server-builder /app/server ./server

# Copy collector with dependencies from collector-builder
COPY --from=collector-builder /app/collector ./collector

# Copy root package.json for scripts
COPY package*.json ./

# Create necessary directories for runtime
RUN mkdir -p /app/storage/lancedb && \
    mkdir -p /app/storage/documents && \
    mkdir -p /app/storage/vector-cache && \
    mkdir -p /app/storage/uploads && \
    mkdir -p /app/logs && \
    chmod -R 777 /app/storage && \
    chmod -R 777 /app/logs

# Copy startup script
COPY render/start.sh /app/start.sh
RUN chmod +x /app/start.sh

# Expose ports (Render uses 10000 by default)
EXPOSE 10000 8888

# Health check (use PORT env var, defaults to 10000)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:10000/api/v1/system/check || exit 1

# Set environment variables
ENV NODE_ENV=production
ENV PORT=10000
ENV SERVER_PORT=10000
ENV COLLECTOR_PORT=8888
ENV STORAGE_DIR=/app/storage

# Start application
CMD ["/app/start.sh"]
