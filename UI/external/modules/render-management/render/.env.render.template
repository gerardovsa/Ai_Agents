# ============================================
# MustCare ValorAISynergySuite V3 - Render Environment Template
# Copy this to Render Dashboard → Environment Variables
# ============================================

# ========================================
# REQUIRED: Anthropic API Configuration
# ========================================
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ========================================
# REQUIRED: JWT Secret (Auto-generated by Render)
# ========================================
# Render will auto-generate if not provided
# Or generate manually: openssl rand -hex 32
JWT_SECRET=auto-generated-by-render

# ========================================
# REQUIRED: Database (Auto-configured by Render)
# ========================================
DATABASE_URL=postgresql://user:password@host:port/database

# ========================================
# Multi-User Authentication
# ========================================
MULTI_USER_MODE=true
DISABLE_TELEMETRY=true
AUTH_TOKEN=auto-generated-by-render
PASSWORDMINCHAR=8

# ========================================
# LLM Configuration
# ========================================
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL_PREF=claude-sonnet-4-20250514

# ========================================
# Advanced Anthropic Features
# ========================================
ANTHROPIC_WEB_SEARCH_ENABLED=true
ANTHROPIC_CODE_EXECUTION_ENABLED=true
ANTHROPIC_TOOL_USE_ENABLED=true
ANTHROPIC_THINKING_MODE=interleaved

# ========================================
# Vector Database Configuration
# ========================================
VECTOR_DB=lancedb
STORAGE_DIR=/app/storage
EMBEDDING_ENGINE=native
EMBEDDING_MODEL_PREF=nomic-embed-text-v1.5
EMBEDDING_BASE_PATH=https://embedding.anythingllm.com
CACHE_VECTORS=true

# ========================================
# Server Configuration
# ========================================
SERVER_PORT=3001
COLLECTOR_PORT=8888
NODE_ENV=production
WHISPER_PROVIDER=local
TTS_PROVIDER=native

# ========================================
# Security Configuration (Auto-generated)
# ========================================
SIG_KEY=auto-generated-by-render
SIG_SALT=auto-generated-by-render

# ========================================
# Feature Flags
# ========================================
ENABLE_QUICK_ACTIONS=true
ENABLE_WEB_SEARCH=true
ENABLE_CODE_EXECUTION=true

# ========================================
# Optional: OpenAI Fallback
# ========================================
# Uncomment if you want OpenAI as a fallback provider
# OPENAI_API_KEY=sk-your-openai-key-here

# ========================================
# Optional: Google Services Integration
# ========================================
# Uncomment if you want Google Search integration
# GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id
# GOOGLE_API_KEY=your-google-api-key
