{
    "id": "thread-cards",
    "name": "Thread Cards",
    "version": "2.0.0",
    "description": "Modular thread card system with real-time updates and action handlers",
    "author": "AI Agents Platform",
    "icon": "fas fa-comments",
    "color": "#8b5cf6",
    "colors": {
        "primary": "#8b5cf6",
        "secondary": "#a78bfa",
        "hover": "#7c3aed"
    },
    "dependencies": [
        "supabase",
        "thread-manager"
    ],
    "exports": {
        "ThreadCardTemplates": "window.ThreadCardTemplates",
        "ThreadCardRealtime": "window.ThreadCardRealtime",
        "ThreadCardActions": "window.ThreadCardActions"
    },
    "files": {
        "styles": [
            "thread-card-styles.css"
        ],
        "scripts": [
            "thread-card-templates.js",
            "thread-card-realtime.js",
            "thread-card-actions.js"
        ]
    },
    "enabled": true
}