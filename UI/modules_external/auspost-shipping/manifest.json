{
  "module_name": "auspost-shipping",
  "version": "1.0.0",
  "description": "Australia Post shipping cost calculator with API integration",
  "author": "InHouse Print",
  "created": "2026-01-29",
  "status": "active",
  "category": "shipping",
  "dependencies": {
    "python": ["requests>=2.31.0", "python-dotenv>=1.0.0"],
    "environment_variables": ["AUSPOST_API_KEY"]
  },
  "tool_definitions": [
    "tools/auspost_tools.json"
  ],
  "implementations": [
    "implementations/auspost_wrapper.py"
  ],
  "backend_modules": [
    "backend/auspost_client.py",
    "backend/order_parser.py",
    "backend/box_calculator.py"
  ],
  "features": [
    "Parse label data with product codes",
    "Calculate product dimensions and weight",
    "Determine optimal box size",
    "Australia Post API integration",
    "Domestic and international postage calculation",
    "Batch order processing",
    "Cost breakdown by service type"
  ],
  "api_endpoints": {
    "base_url": "https://digitalapi.auspost.com.au",
    "test_url": "https://test.npe.auspost.com.au"
  },
  "supported_products": {
    "CFS": {"weight_grams": 220, "thickness_mm": 20},
    "MVG": {"weight_grams": 325, "thickness_mm": 30},
    "MVGEQ": {"weight_grams": 220, "thickness_mm": 20},
    "MVGEM": {"weight_grams": 370, "thickness_mm": 35}
  },
  "supported_boxes": {
    "small": {"weight_grams": 50, "depth_mm": 45, "max_depth_mm": 60},
    "large": {"weight_grams": 60, "depth_mm": 70, "max_depth_mm": 85}
  }
}
