    "calculation_formula": {
        "description": "Luxury pull up banner pricing with size-specific quantity discounts and artwork setup costs",
        "steps": [
            "1. Calculate artwork setup: IF artworks > 1 THEN (artworks * 6) - 6 ELSE 0",
            "2. Determine price per unit based on size selection and quantity using tiered pricing tables",
            "3. Calculate subtotal: quantity * price_per_unit",
            "4. Add costs: subtotal + artwork_setup + production_setup (15)",
            "5. Apply first markup: result * 1.1",
            "6. Apply final multiplier: result * 1.1"
        ]
    },
    "validation_rules": {
        "quantity": {
            "required": true,
            "min": 1,
            "max": 100,
            "type": "integer"
        },
        "artworks": {
            "required": true,
            "min": 1,
            "max": 20,
            "type": "integer",
            "visibility_condition": "quantity > 2"
        },
        "base_colour": {
