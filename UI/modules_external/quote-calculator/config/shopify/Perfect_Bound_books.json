{
  "product": "perfect_bound_books",
  "version": "1.0",
  "pricing_constants": {
    "setup_costs": {
      "guilo_setup": 10,
      "impos_setup": 50,
      "binder_setup": 35
    },
    "production_constants": {
      "stock_waste": 1.05,
      "extra_arts": 30,
      "cutting_block": 500,
      "cut_cost": 11,
