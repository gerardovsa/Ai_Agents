    "calculation_formula": {
        "description": "Corflute Insert A-Frame pricing with complex quantity-based tiered rates and artwork charges",
        "steps": [
            "1. Calculate artwork cost: _a = artworks * 5, _a2 = IF _a <= 5 THEN 0 ELSE (_a - 5)",
            "2. Determine unit price based on quantity using 25 different pricing tiers:",
            "   - Single unit: $159",
            "   - 2 units: $146.94 each",
            "   - 3 units: $138.33 each",
            "   - 4 units: $130 each",
            "   - 5 units: $125 each",
            "   - Continues with decreasing rates up to bulk pricing",
            "   - 101+ units: $99 each (bulk rate)",
            "3. Calculate subtotal: quantity * unit_price",
            "4. Add artwork charges: subtotal + artwork_cost",
            "5. Apply GST: total * 1.1"
        ]
    },
