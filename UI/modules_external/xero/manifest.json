{
    "id": "xero",
    "name": "Xero Accounting",
    "version": "1.0.0",
    "type": "external",
    "category": "business",
    "description": "Xero accounting integration for invoices, contacts, payments, and financial reporting across InHouse Print, Publishing, and Signs",
    "icon": "fas fa-file-invoice-dollar",
    "show_in_sidebar": true,
    "main_script": "xero.js",
    "styles": [
        "xero.css"
    ],
    "routes_file": "routes/xero.py",
    "dependencies": [
        "xero-quick-prompts.js",
        "https://cdn.plot.ly/plotly-2.27.0/dist/plotly.min.js",
        "https://unpkg.com/tabulator-tables@5.5.0/dist/css/tabulator.min.css",
        "https://unpkg.com/tabulator-tables@5.5.0/dist/js/tabulator.min.js",
        "/css/tabulator-enhancements.css",
        "/js/tabulator-functions.js"
    ],
    "colors": {
        "primary": "#13B5EA",
        "secondary": "#0E8BC0",
        "hover": "#0F9ED5"
    },
    "author": "InHouse Print",
    "capabilities": {
        "dashboard": {
            "enabled": true,
            "tab_id": "xero",
            "tab_label": "Xero Accounting",
            "tab_icon": "fas fa-file-invoice-dollar",
            "rendering": "js-controlled",
            "initialization": "lazy"
        }
    },
    "settings": {
        "api_endpoint": "/api/xero"
    },
    "tabs": [
        {
            "id": "dashboard",
            "name": "Dashboard",
            "icon": "fas fa-tachometer-alt",
            "description": "Financial overview and key metrics",
            "default": true
        },
        {
            "id": "invoices",
            "name": "Invoices",
            "icon": "fas fa-file-invoice",
            "description": "Invoice management and tracking"
        },
        {
            "id": "contacts",
            "name": "Contacts",
            "icon": "fas fa-address-book",
            "description": "Customer and supplier contacts"
        },
        {
            "id": "payments",
            "name": "Payments",
            "icon": "fas fa-money-bill-wave",
            "description": "Payment records and reconciliation"
        },
        {
            "id": "accounts",
            "name": "Chart of Accounts",
            "icon": "fas fa-chart-pie",
            "description": "Account codes and categories"
        },
        {
            "id": "reports",
            "name": "Reports",
            "icon": "fas fa-chart-line",
            "description": "Financial reports and analytics"
        }
    ]
}