    "calculation_formula": {
        "description": "A4 strut card pricing with extensive quantity-based tiered pricing and artwork setup costs",
        "steps": [
            "1. Calculate artwork setup: IF artworks > 1 THEN (artworks * 5) - 5 ELSE 0",
            "2. Determine price per unit based on quantity using 25 different pricing tiers",
            "3. Calculate base cost: quantity * price_per_unit",
            "4. Add artwork setup cost: base_cost + artwork_setup",
            "5. Apply minimum order value: IF subtotal < 79 THEN 79 ELSE subtotal",
            "6. Apply first markup: IF subtotal >= 79 THEN subtotal * 1.1 ELSE 79",
            "7. Apply final multiplier: result * 1.1"
        ]
    },
