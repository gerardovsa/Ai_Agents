  "pricing_constants": {
    "eyelet_cost_per_unit": 0.55,
    "artwork_value_each": 5.00,
    "free_artworks": 5,
    "double_sided_cost_per_sqm": 6.00,
    "custom_size_premium_multiplier": 1.10,
    "discount_multiplier": 0.95,
    "minimum_order_value": 135.00,
    "shipping_surcharge": 45.00,
    "shipping_dimension_threshold_mm": 1800
  },
  
  "calculation_formula": {
    "step_1": {
      "name": "Calculate dimensions",
      "description": "Get width and height from preset or custom input",
      "formula": "If size_preset != 'custom': use preset dimensions. Else: use custom_width_mm and custom_height_mm"
    },
    
    "step_2": {
      "name": "Calculate total square meters",
      "description": "Area per unit × quantity",
      "formula": "sqm_per_unit = (width_mm × height_mm) / 1,000,000 | total_sqm = sqm_per_unit × quantity"
    },
    
    "step_3": {
      "name": "Get tier price per sqm",
      "description": "Lookup price from tier table based on total_sqm and thickness",
      "formula": "tier_price = lookup(pricing_tiers[thickness], total_sqm)"
    },
    
    "step_4": {
      "name": "Calculate base cost",
      "description": "Material and printing cost",
      "formula": "base_cost = total_sqm × tier_price"
    },
    
    "step_5": {
      "name": "Add double-sided cost",
      "description": "Extra cost if printing both sides",
      "formula": "double_sided_cost = total_sqm × 6.00 (if double_sided=true, else 0)"
    },
    
    "step_6": {
      "name": "Apply custom size premium",
      "description": "10% surcharge for non-standard sizes",
      "formula": "cost_before_custom = base_cost + double_sided_cost | custom_premium = cost_before_custom × 0.10 (if size_preset='custom', else 0) | cost_after_custom = cost_before_custom × 1.10 (if custom, else 1.0)"
    },
    
    "step_7": {
      "name": "Calculate eyelet cost",
      "description": "Cost for eyelets/grommets",
      "formula": "eyelet_cost = eyelet_count × 0.55 × quantity"
    },
    
    "step_8": {
      "name": "Calculate artwork cost",
      "description": "First 5 artworks free, then $5 each",
      "formula": "artwork_value = artworks × 5.00 | artwork_cost = max(0, artwork_value - 25.00)"
    },
    
    "step_9": {
      "name": "Apply discount",
      "description": "5% discount on all orders",
      "formula": "subtotal_before_discount = cost_after_custom + eyelet_cost + artwork_cost | discount_amount = subtotal_before_discount × 0.05 | subtotal_after_discount = subtotal_before_discount × 0.95"
    },
    
    "step_10": {
      "name": "Apply minimum order",
      "description": "Enforce $135 minimum",
      "formula": "total = max(subtotal_after_discount, 135.00) | per_unit = total / quantity"
    }
  },
  
  "validation_rules": {
    "size_preset": {
      "required": true,
      "allowed_values": ["450x600mm", "600x900mm", "900x1200mm", "1200x2400mm", "custom"]
    },
    "custom_width_mm": {
      "required_if": "size_preset == 'custom'",
      "min": 100,
      "max": 2400,
      "error_message": "Custom width must be between 100mm and 2400mm"
    },
    "custom_height_mm": {
      "required_if": "size_preset == 'custom'",
      "min": 100,
      "max": 2400,
      "error_message": "Custom height must be between 100mm and 2400mm"
    },
    "thickness": {
      "required": true,
      "allowed_values": ["3mm", "5mm"]
    },
    "quantity": {
      "required": true,
      "min": 1,
      "max": 10000,
      "error_message": "Quantity must be between 1 and 10,000"
    },
    "eyelet_option": {
      "required": true,
      "allowed_values": ["none", "4_corners", "2_top", "2_center_lr", "2_center_tb", "6_top_bottom", "6_left_right"]
    },
    "artworks": {
      "required": true,
      "min": 1,
      "max": 100,
      "error_message": "Artworks must be between 1 and 100"
    }
  },
  
  "visibility_rules": {
    "custom_width_mm": {
      "visible_when": {
        "field": "size_preset",
        "operator": "==",
        "value": "custom"
      }
    },
    "custom_height_mm": {
      "visible_when": {
        "field": "size_preset",
        "operator": "==",
        "value": "custom"
      }
    }
  },
  
