    "calculation_formula": {
      "description": "Square-metre base pricing converted to roll linear metres when needed; includes roll setup, laminating and cutting labour rules",
      "steps": [
        "1. Determine sticker width_mm and height_mm from size or custom fields",
        "2. Calculate sqm_per_sticker = (width_mm * height_mm) / 1,000,000",
        "3. total_sqm = sqm_per_sticker * quantity",
        "4. For roll-based costing: compute stickers_per_row = floor(roll_width_mm / sticker_width_mm)",
        "   stickers_per_linear_m = stickers_per_row * floor(1000 / sticker_height_mm)",
        "   raw_linear_m = ceil(quantity / stickers_per_linear_m)",
        "   linear_m_with_waste = raw_linear_m * 1.10",
        "   per_linear_m_rate = base_rate_per_sqm * roll_width_m (if converting from sqm rates)",
        "   material_cost_by_line = per_linear_m_rate * linear_m_with_waste",
        "5. Determine base_rate_per_sqm from the 51-tier table using total_sqm",
        "6. Apply material and finish multipliers to get final_rate_per_sqm",
        "7. printing_cost = total_sqm * final_rate_per_sqm (or use material_cost_by_line)",
        "8. rolls_needed = ceil((linear_m_with_waste * 1.0) / default_roll_length_m)",
        "9. per_roll_setup_total = per_extra_roll_setup_fee * max(0, rolls_needed - 1)",
        "10. laminating_cost = laminating_setup_fee + (laminating_hours * labour_rate)",
        "    where laminating_hours = rolls_needed / rolls_per_hour",
        "11. cutting_labour_minutes = linear_m_with_waste * per_linear_meter_minutes",
        "    cutting_labour_cost = (cutting_labour_minutes / 60) * labour_rate",
        "12. kiss_cut_surcharge = kiss_cut_per_linear_m * linear_m_with_waste (if kiss-cut selected)",
        "13. subtotal = printing_cost + per_roll_setup_total + laminating_cost + cutting_labour_cost + kiss_cut_surcharge + artwork_cost",
        "14. total_with_gst = subtotal * gst_rate",
        "15. apply minimum order rule and handling fee"
      ]
    }
