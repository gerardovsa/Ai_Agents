# ========================================
# AI AGENTS - ENVIRONMENT VARIABLES TEMPLATE
# ========================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env

# ========================================
# GOOGLE OAUTH 2.0 CREDENTIALS
# ========================================
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-extension-id.chromiumapp.org/
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/documents,https://www.googleapis.com/auth/drive

# ========================================
# MICROSOFT 365 OAUTH 2.0 CREDENTIALS
# ========================================
MICROSOFT_CLIENT_ID=your-application-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret-value
MICROSOFT_REDIRECT_URI=http://localhost:5001/api/auth/microsoft/callback
MICROSOFT_TENANT=common
# Tenant options:
# - 'common': Multi-tenant (personal and work accounts)
# - 'organizations': Work/school accounts only
# - 'consumers': Personal Microsoft accounts only
# - '<tenant-id>': Specific Azure AD tenant

# ========================================
# GOOGLE SERVICE ACCOUNT
# ========================================
SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
SERVICE_ACCOUNT_PRIVATE_KEY_ID=your-private-key-id
SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
SERVICE_ACCOUNT_PROJECT_ID=your-project-id

# ========================================
# CLOUDFLARE
# ========================================
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_AI_AGENT_TOKEN=your-token

# ========================================
# SUPABASE
# ========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SERVICE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres

# ========================================
# WOOCOMMERCE
# ========================================
WC_CONSUMER_KEY=ck_your-consumer-key
WC_CONSUMER_SECRET=cs_your-consumer-secret
WC_BASE_URL=https://your-store.com/wp-json/wc/v3/orders
WC_STORE_URL=https://your-store.com

# ========================================
# GITHUB
# ========================================
GITHUB_EMAIL=your-email@example.com
GITHUB_PASSWORD=your-password
GITHUB_USERNAME=your-username
GITHUB_TOKEN=your-personal-access-token

# ========================================
# AI API KEYS - DEEPSEEK
# ========================================
DEEPSEEK_API_KEY_1=sk-your-key-1
DEEPSEEK_API_KEY_2=sk-your-key-2
DEEPSEEK_API_KEY_3=sk-your-key-3
DEEPSEEK_API_KEY_4=sk-your-key-4
DEEPSEEK_API_KEY_5=sk-your-key-5
DEEPSEEK_API_KEY_6=sk-your-key-6
DEEPSEEK_API_KEY_7=sk-your-key-7
DEEPSEEK_API_KEY_8=sk-your-key-8
DEEPSEEK_API_KEY_9=sk-your-key-9
DEEPSEEK_API_KEY_10=sk-your-key-10
DEEPSEEK_KEYS=["sk-key-1","sk-key-2","sk-key-3"]
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=8192

# ========================================
# AI API KEYS - ANTHROPIC (CLAUDE)
# ========================================
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_KEYS=["sk-ant-your-key"]

# ========================================
# AI API KEYS - OPENAI (GPT)
# ========================================
OPENAI_API_KEY=sk-proj-your-key
OPENAI_KEYS=["sk-proj-your-key"]

# ========================================
# AI API KEYS - MINIMAX (M-series)
# ========================================
# MiniMax exposes an Anthropic-compatible endpoint, so we use the same SDK
# with a different base URL.  Get a key from:
#   https://platform.minimax.io/user-center/payment/token-plan
MINIMAX_API_KEY=eyJ-your-key
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_KEYS=["eyJ-your-key"]

# ========================================
# AI MODEL CONFIGURATION
# ========================================
DEFAULT_AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=8000
AI_REQUEST_TIMEOUT=300
AI_MAX_RETRIES=3
AI_RETRY_DELAY=2.0
AI_BATCH_SIZE=5

# ========================================
# RENDER.COM
# ========================================
RENDER_API_KEY=your-render-api-key
RENDER_SERVICE_ID=your-service-id
RENDER_SERVICE_NAME=your-service-name

# ========================================
# SENTRY (error tracking — optional)
# ========================================
# Free tier: 5K errors/month, 10K performance events/month
# Get a DSN from: https://sentry.io/settings/<org>/projects/<project>/keys/
# If unset, error tracking is disabled and the app runs normally.
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_ENVIRONMENT=staging  # or "production" — used as a Sentry tag
SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% of requests — drop to 0.01 for prod
SENTRY_SEND_PII=true  # forwards org_id / user_id from JWT to Sentry

# ========================================
# SLACK (deploy + alert notifications)
# ========================================
# Incoming webhook URL — Render's deploy-notification system uses a
# different setup (Settings → Notifications); this one is for our
# debug agent's alert path.
# Get one from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# ========================================
# DEBUG AGENT (background observability)
# ========================================
# Runs as a standalone CLI:
#   python -m monitoring.debug_agent check       # one-shot probe
#   python -m monitoring.debug_agent daemon      # long-running loop
# Typically launched as a Render cron job or a separate background worker
PLATFORM_BASE_URL=https://ai-agents-v10.onrender.com
DEBUG_AGENT_AUTH_TOKEN=  # JWT for /api/admin/diagnostics; leave blank to disable auth probe
DEBUG_AGENT_INTERVAL_SEC=300               # 5 min default
DEBUG_AGENT_AUTO_HEAL=false                # set "true" to restart service on sustained failure
DEBUG_AGENT_HEALTH_FAIL_THRESHOLD=3        # consecutive failures before auto-heal
DEBUG_AGENT_LOG_LEVEL=INFO

# ========================================
# MICROSOFT 365
# ========================================
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:8080/callback
MICROSOFT_SCOPES=Mail.Send,Mail.Read,Files.ReadWrite.All,User.Read

# ========================================
# STREAMLIT
# ========================================
STREAMLIT_SERVER_PORT=10000
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false

# ========================================
# APPLICATION SETTINGS
# ========================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
PYTHONPATH=/opt/render/project/src

# ========================================
# SECURITY
# ========================================
SECURE_MODE=true
ALLOWED_HOSTS=your-app.onrender.com,localhost
CORS_ALLOWED_ORIGINS=https://your-site.com,http://localhost:3000
SESSION_SECRET=your-random-secret
JWT_SECRET=your-jwt-secret
ENCRYPTION_KEY=your-encryption-key

# ========================================
# PERFORMANCE
# ========================================
CACHE_TTL=3600
MAX_WORKERS=4
ANALYTICS_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ========================================
# CUSTOM ENDPOINTS
# ========================================
MUSTCARE_BACKEND_URL=https://your-backend.run.app
MUSTCARE_API_KEY=your-api-key

# ========================================
# ASSEMBLYAI - SPEECH-TO-TEXT
# ========================================
ASSEMBLYAI_API_KEY=your-assemblyai-key
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com/v2

# ========================================
# CLOUDCONVERT - FILE CONVERSION
# ========================================
CLOUDCONVERT_API_KEY=your-cloudconvert-jwt-token
CLOUDCONVERT_BASE_URL=https://api.cloudconvert.com/v2
CLOUDCONVERT_WEBHOOK_SIGNING_SECRET=your-webhook-secret

# ========================================
# NGROK - TUNNELING
# ========================================
NGROK_AUTHTOKEN=your-ngrok-authtoken
NGROK_REGION=au
NGROK_API_KEY=your-ngrok-api-key
# ========================================
# AUSTRALIA POST - SHIPPING API
# ========================================
AUSPOST_API_KEY=your-auspost-api-key
# Get your API key from: https://developers.auspost.com.au/
# Documentation: https://developers.auspost.com.au/apis/pac/reference