{
    "platform": "xero",
    "description": "Xero Accounting API - Invoices, contacts, accounts, payments, bank transactions",
    "tools": [
        {
            "name": "xero_platform_guide",
            "description": "⚠️ CALL THIS FIRST! Get comprehensive guidance on using Xero tools effectively. Returns tool recommendations, best practices, warnings about large datasets, and workflow examples. Essential reading before using any other Xero tools.",
            "platform": "xero",
            "parameters": {
                "type": "object",
                "properties": {
                    "task_description": {
                        "type": "string",
                        "description": "What you want to do (e.g., 'get recent invoices', 'find customer', 'accounts payable report'). Optional - if omitted, returns general guide."
                    }
                },
                "required": []
            },
            "returns": {
                "type": "object",
                "description": "Comprehensive guide including: tool recommendations for your task, best practices, warnings about data volume, workflow steps, and common pitfalls to avoid"
            }
        },
        {
            "name": "xero_get_invoices",
            "description": "⚠️ WARNING: Can return 50,000+ invoices (100MB+ data). RECOMMENDED: Use xero_get_data_metadata FIRST to check volume, then use xero_get_invoices_by_date_range with specific dates. This tool returns ALL invoices matching filters - use status filter to reduce volume (e.g., status='AUTHORISED' for unpaid only).",
            "platform": "xero",
            "parameters": {
                "type": "object",
                "properties": {
                    "business_id": {
                        "type": "integer",
                        "description": "Business ID (1=InHouse Print, 2=Publishing, 3=Signs)",
                        "default": 1
                    },
                    "status": {
                        "type": "string",
                        "description": "Invoice status filter (DRAFT, SUBMITTED, AUTHORISED, PAID)"
                    },
                    "contact_name": {
                        "type": "string",
                        "description": "Filter by contact name (optional)"
                    },
                    "invoice_number": {
                        "type": "string",
                        "description": "Specific invoice number (optional)"
                    }
                },
                "required": [
                    "business_id"
                ]
            },
            "returns": {
                "type": "object",
                "description": "List of invoices with details"
            }
        },
        {
            "name": "xero_get_invoice_by_id",
            "description": "Get a specific invoice by Xero invoice ID",
            "platform": "xero",
            "parameters": {
                "type": "object",
                "properties": {
                    "business_id": {
                        "type": "integer",
                        "description": "Business ID (1=InHouse Print, 2=Publishing, 3=Signs)"
                    },
                    "invoice_id": {
                        "type": "string",
                        "description": "Xero invoice GUID"
                    }
                },
                "required": [
                    "business_id",
                    "invoice_id"
                ]
            },
            "returns": {
                "type": "object",
                "description": "Invoice details including number, date, total, status"
            }
        },
        {
            "name": "xero_get_contacts",
            "description": "⚠️ WARNING: Can return 7,000+ contacts (3.5MB+ data). RECOMMENDED: Use xero_get_data_metadata FIRST to check volume, then use xero_get_contacts_by_date_range for recent contacts, OR use search parameter to filter by name (e.g., search='Smith' finds 'John Smith', 'Smith Corp').",
            "platform": "xero",
            "parameters": {
                "type": "object",
                "properties": {
                    "business_id": {
                        "type": "integer",
                        "description": "Business ID (1=InHouse Print, 2=Publishing, 3=Signs)"
                    },
                    "search": {
                        "type": "string",
                        "description": "Search by contact name (optional)"
                    }
                },
                "required": [
                    "business_id"
                ]
            },
            "returns": {
                "type": "array",
                "description": "List of contacts with details"
            }
        },
        {
            "name": "xero_create_invoice",
            "description": "Create a new invoice in Xero",
            "platform": "xero",
            "parameters": {
                "type": "object",
                "properties": {
                    "business_id": {
                        "type": "integer",
                        "description": "Business ID (1=InHouse Print, 2=Publishing, 3=Signs)"
                    },
                    "contact_id": {
                        "type": "string",
                        "description": "Xero contact ID (use xero_get_contacts to find)"
                    },
                    "invoice_type": {
                        "type": "string",
                        "description": "ACCREC (sales) or ACCPAY (bills)",
                        "default": "ACCREC"
                    },
                    "line_items": {
                        "type": "array",
                        "description": "Invoice line items",
                        "items": {
                            "type": "object",
                            "properties": {
                                "description": {
                                    "type": "string"
                                },
                                "quantity": {
                                    "type": "number"
                                },
                                "unit_amount": {
                                    "type": "number"
                                },
                                "account_code": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "due_date": {
                        "type": "string",
                        "description": "Due date (YYYY-MM-DD)"
                    }
                },
                "required": [
                    "business_id",
                    "contact_id",
                    "line_items"
                ]
            },
            "returns": {
                "type": "object",
                "description": "Created invoice with ID and invoice number"
            }
        },
        {
            "name": "xero_get_accounts",
            "description": "Get chart of accounts from Xero",
            "platform": "xero",
            "parameters": {
                "type": "object",
                "properties": {
                    "business_id": {
                        "type": "integer",
                        "description": "Business ID (1=InHouse Print, 2=Publishing, 3=Signs)"
                    }
                },
                "required": [
                    "business_id"
                ]
            },
            "returns": {
                "type": "array",
                "description": "List of accounts with codes and names"
            }
        },
        {
            "name": "xero_get_bank_transactions",
            "description": "⚠️ WARNING: Can return 33,000+ transactions (16MB+ data). STRONGLY RECOMMENDED: Use xero_get_data_metadata FIRST, then use xero_get_bank_transactions_by_date_range with specific date range (e.g., last month). This tool returns ALL transactions if no date filters provided.",
            "platform": "xero",
            "parameters": {
                "type": "object",
                "properties": {
                    "business_id": {
                        "type": "integer",
                        "description": "Business ID (1=InHouse Print, 2=Publishing, 3=Signs)"
                    },
                    "from_date": {
                        "type": "string",
                        "description": "Start date filter (YYYY-MM-DD)"
                    },
                    "to_date": {
                        "type": "string",
                        "description": "End date filter (YYYY-MM-DD)"
                    }
                },
                "required": [
                    "business_id"
                ]
            },
            "returns": {
                "type": "array",
                "description": "List of bank transactions"
            }
        },
        {
            "name": "xero_get_payments",
            "description": "⚠️ WARNING: Can return 54,000+ payments (16MB+ data). RECOMMENDED: Use xero_get_data_metadata FIRST to check volume, then use xero_get_payments_by_date_range with specific dates, OR use invoice_id parameter to get payments for a specific invoice.",
            "platform": "xero",
            "parameters": {
                "type": "object",
                "properties": {
                    "business_id": {
                        "type": "integer",
                        "description": "Business ID (1=InHouse Print, 2=Publishing, 3=Signs)"
                    },
                    "invoice_id": {
                        "type": "string",
                        "description": "Filter by invoice ID (optional)"
                    }
                },
                "required": [
                    "business_id"
                ]
            },
            "returns": {
                "type": "array",
                "description": "List of payments"
            }
        },
        {
            "name": "xero_get_data_metadata",
            "description": "Get metadata about Xero data volumes and date ranges. Returns total counts and creation date ranges for contacts, invoices, payments, and bank transactions. Use this FIRST to understand data scale before retrieving large datasets.",
            "platform": "xero",
            "parameters": {
                "type": "object",
                "properties": {
                    "business_id": {
                        "type": "integer",
                        "description": "Business ID (1=InHouse Print, 2=Publishing, 3=Signs)",
                        "default": 1
                    }
                },
                "required": [
                    "business_id"
                ]
            },
            "returns": {
                "type": "object",
                "description": "Metadata including total counts, date ranges, average data sizes, and time-based breakdowns (1wk, 2wk, 1mo, 3mo, 6mo, 12mo, 24mo)"
            }
        },
        {
            "name": "xero_get_contacts_by_date_range",
            "description": "Get contacts created within a specific date range. Use xero_get_data_metadata first to understand volume.",
            "platform": "xero",
            "parameters": {
                "type": "object",
                "properties": {
                    "business_id": {
                        "type": "integer",
                        "description": "Business ID (1=InHouse Print, 2=Publishing, 3=Signs)",
                        "default": 1
                    },
                    "from_date": {
                        "type": "string",
                        "description": "Start date (YYYY-MM-DD format)"
                    },
                    "to_date": {
                        "type": "string",
                        "description": "End date (YYYY-MM-DD format)"
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Maximum number of contacts to return (default: 1000)",
                        "default": 1000
                    }
                },
                "required": [
                    "business_id",
                    "from_date",
                    "to_date"
                ]
            },
            "returns": {
                "type": "object",
                "description": "Contacts within date range with count and data size estimate"
            }
        },
        {
            "name": "xero_get_invoices_by_date_range",
            "description": "Get invoices within a specific date range. Use xero_get_data_metadata first to understand volume.",
            "platform": "xero",
            "parameters": {
                "type": "object",
                "properties": {
                    "business_id": {
                        "type": "integer",
                        "description": "Business ID (1=InHouse Print, 2=Publishing, 3=Signs)",
                        "default": 1
                    },
                    "from_date": {
                        "type": "string",
                        "description": "Invoice start date (YYYY-MM-DD format)"
                    },
                    "to_date": {
                        "type": "string",
                        "description": "Invoice end date (YYYY-MM-DD format)"
                    },
                    "status": {
                        "type": "string",
                        "description": "Invoice status filter (DRAFT, SUBMITTED, AUTHORISED, PAID)"
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Maximum number of invoices to return (default: 1000)",
                        "default": 1000
                    }
                },
                "required": [
                    "business_id",
                    "from_date",
                    "to_date"
                ]
            },
            "returns": {
                "type": "object",
                "description": "Invoices within date range with count and data size estimate"
            }
        },
        {
            "name": "xero_get_payments_by_date_range",
