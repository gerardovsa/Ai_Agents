        {
            "name": "xero_get_accounts_metadata",
            "description": "Get metadata about chart of accounts including total count, account types breakdown, and active vs archived accounts. Use this FIRST before retrieving all accounts.",
            "platform": "xero",
            "parameters": {
                "type": "object",
                "properties": {
                    "business_id": {
                        "type": "integer",
                        "description": "Business ID (1=InHouse Print, 2=Publishing, 3=Signs)",
                        "default": 1
                    }
                },
                "required": [
                    "business_id"
                ]
            },
            "returns": {
                "type": "object",
                "description": "Account metadata including total count, breakdown by type (BANK, REVENUE, EXPENSE, etc.), active/archived status, and data size estimate"
            }
        },
        {
            "name": "xero_get_accounts_by_type",
            "description": "Get accounts filtered by account type. More efficient than retrieving all accounts.",
            "platform": "xero",
            "parameters": {
                "type": "object",
                "properties": {
                    "business_id": {
                        "type": "integer",
                        "description": "Business ID (1=InHouse Print, 2=Publishing, 3=Signs)",
                        "default": 1
                    },
                    "account_type": {
                        "type": "string",
                        "description": "Account type filter (BANK, CURRENT, CURRLIAB, DEPRECIATN, DIRECTCOSTS, EQUITY, EXPENSE, FIXED, INVENTORY, LIABILITY, NONCURRENT, OTHERINCOME, OVERHEADS, PREPAYMENT, REVENUE, SALES, TERMLIAB, PAYGLIABILITY, SUPERANNUATIONEXPENSE, SUPERANNUATIONLIABILITY, WAGESEXPENSE, WAGESPAYABLELIABILITY)"
                    },
                    "status": {
                        "type": "string",
                        "description": "Status filter: ACTIVE or ARCHIVED (default: ACTIVE)",
                        "default": "ACTIVE"
                    }
                },
                "required": [
                    "business_id",
                    "account_type"
                ]
            },
            "returns": {
                "type": "object",
                "description": "Filtered accounts with count and details"
            }
        },
        {
            "name": "xero_get_bank_transactions_by_date_range",
            "description": "Get bank transactions within a specific date range with additional filters. Use xero_get_data_metadata first to understand volume.",
