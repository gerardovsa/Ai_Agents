{
  "tools": [
    {
      "name": "google_slides_create_presentation",
      "description": "Create a new Google Slides presentation (blank or from template)",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Presentation title"
          },
          "template_id": {
            "type": "string",
            "description": "Optional: Template presentation ID to copy from"
          }
        },
        "required": ["title"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "presentation_id": {"type": "string"},
          "url": {"type": "string"},
          "title": {"type": "string"},
          "slide_count": {"type": "integer"}
        }
      }
    },
    {
      "name": "google_slides_get_presentation",
      "description": "Get presentation details including all slides, layouts, and masters",
      "parameters": {
        "type": "object",
        "properties": {
          "presentation_id": {
            "type": "string",
            "description": "Presentation ID"
          }
        },
        "required": ["presentation_id"]
      },
      "returns": {
        "type": "object",
        "description": "Full presentation object"
      }
    },
    {
      "name": "google_slides_add_slide",
      "description": "Add a new slide to presentation with specific layout",
      "parameters": {
        "type": "object",
        "properties": {
          "presentation_id": {
            "type": "string",
            "description": "Presentation ID"
          },
          "layout": {
            "type": "string",
            "description": "Layout type: BLANK, TITLE, TITLE_AND_BODY, TITLE_AND_TWO_COLUMNS, TITLE_ONLY, SECTION_HEADER, SECTION_TITLE_AND_DESCRIPTION, ONE_COLUMN_TEXT, MAIN_POINT, BIG_NUMBER",
            "default": "BLANK"
          },
          "index": {
            "type": "integer",
            "description": "Position to insert slide (null = end)"
          }
        },
        "required": ["presentation_id"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "slide_id": {"type": "string"},
          "page_index": {"type": "integer"},
          "layout": {"type": "string"}
        }
      }
    },
    {
      "name": "google_slides_delete_slide",
      "description": "Delete a slide from presentation",
      "parameters": {
        "type": "object",
        "properties": {
          "presentation_id": {
            "type": "string",
            "description": "Presentation ID"
          },
          "slide_id": {
            "type": "string",
            "description": "Slide ID to delete"
          }
        },
        "required": ["presentation_id", "slide_id"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "deleted": {"type": "boolean"},
          "slide_id": {"type": "string"}
        }
      }
    },
    {
      "name": "google_slides_duplicate_slide",
      "description": "Duplicate an existing slide",
      "parameters": {
        "type": "object",
        "properties": {
          "presentation_id": {
            "type": "string",
            "description": "Presentation ID"
          },
          "slide_id": {
            "type": "string",
            "description": "Slide ID to duplicate"
          }
        },
        "required": ["presentation_id", "slide_id"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "original_slide_id": {"type": "string"},
          "new_slide_id": {"type": "string"}
        }
      }
    },
    {
      "name": "google_slides_insert_text",
      "description": "Insert text box with full formatting options (fonts, colors, sizes, bold, italic, alignment)",
      "parameters": {
        "type": "object",
        "properties": {
          "presentation_id": {
            "type": "string",
            "description": "Presentation ID"
          },
          "slide_id": {
            "type": "string",
            "description": "Slide ID"
          },
          "text": {
            "type": "string",
            "description": "Text content"
          },
          "x": {
            "type": "number",
            "description": "X position in points (72 points = 1 inch)",
            "default": 50
          },
          "y": {
            "type": "number",
            "description": "Y position in points",
            "default": 50
          },
          "width": {
            "type": "number",
            "description": "Width in points",
            "default": 600
          },
          "height": {
            "type": "number",
            "description": "Height in points",
            "default": 100
          },
          "font_family": {
            "type": "string",
            "description": "Font name: Arial, Calibri, Times New Roman, Roboto, Montserrat, etc.",
            "default": "Arial"
          },
          "font_size": {
            "type": "integer",
            "description": "Font size in points",
            "default": 14
          },
          "bold": {
            "type": "boolean",
            "description": "Bold text",
            "default": false
          },
          "italic": {
            "type": "boolean",
            "description": "Italic text",
            "default": false
          },
          "color_hex": {
            "type": "string",
            "description": "Text color in hex (#RRGGBB)",
            "default": "#000000"
          },
          "alignment": {
            "type": "string",
            "description": "Text alignment: LEFT, CENTER, RIGHT, JUSTIFIED",
            "default": "LEFT"
          }
        },
        "required": ["presentation_id", "slide_id", "text"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "text_box_id": {"type": "string"},
          "text": {"type": "string"},
          "position": {"type": "object"},
          "size": {"type": "object"}
        }
      }
    },
    {
      "name": "google_slides_insert_image",
      "description": "Insert image from public URL",
      "parameters": {
        "type": "object",
        "properties": {
          "presentation_id": {
            "type": "string",
            "description": "Presentation ID"
          },
          "slide_id": {
            "type": "string",
            "description": "Slide ID"
          },
          "image_url": {
            "type": "string",
            "description": "Public image URL (must be accessible)"
          },
          "x": {
            "type": "number",
            "description": "X position in points",
            "default": 50
          },
          "y": {
            "type": "number",
            "description": "Y position in points",
            "default": 50
          },
          "width": {
            "type": "number",
            "description": "Width in points",
            "default": 400
          },
          "height": {
            "type": "number",
            "description": "Height in points",
            "default": 300
          }
        },
        "required": ["presentation_id", "slide_id", "image_url"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "image_id": {"type": "string"},
          "url": {"type": "string"},
          "position": {"type": "object"},
          "size": {"type": "object"}
        }
      }
    },
    {
      "name": "google_slides_insert_shape",
      "description": "Insert shape with fill and border styling",
      "parameters": {
        "type": "object",
        "properties": {
          "presentation_id": {
            "type": "string",
            "description": "Presentation ID"
          },
          "slide_id": {
            "type": "string",
            "description": "Slide ID"
          },
          "shape_type": {
            "type": "string",
            "description": "Shape type: RECTANGLE, ELLIPSE, ROUND_RECTANGLE, TRIANGLE, RIGHT_TRIANGLE, STAR, ARROW_NORTH, ARROW_EAST, ARROW_SOUTH, ARROW_WEST, etc.",
            "default": "RECTANGLE"
          },
          "x": {
            "type": "number",
            "description": "X position in points",
            "default": 50
          },
          "y": {
            "type": "number",
            "description": "Y position in points",
            "default": 50
          },
          "width": {
            "type": "number",
            "description": "Width in points",
            "default": 200
          },
          "height": {
            "type": "number",
            "description": "Height in points",
            "default": 100
          },
          "fill_color": {
            "type": "string",
            "description": "Fill color hex (#RRGGBB)",
            "default": "#4285F4"
          },
          "border_color": {
            "type": "string",
            "description": "Border color hex (#RRGGBB)",
            "default": "#000000"
          },
          "border_width": {
            "type": "number",
            "description": "Border width in points",
            "default": 1
          }
        },
        "required": ["presentation_id", "slide_id"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "shape_id": {"type": "string"},
          "shape_type": {"type": "string"},
          "position": {"type": "object"},
          "size": {"type": "object"}
        }
      }
    },
    {
      "name": "google_slides_insert_table",
      "description": "Insert table with optional data",
      "parameters": {
        "type": "object",
        "properties": {
          "presentation_id": {
            "type": "string",
            "description": "Presentation ID"
          },
          "slide_id": {
            "type": "string",
            "description": "Slide ID"
          },
          "rows": {
            "type": "integer",
            "description": "Number of rows"
          },
          "columns": {
            "type": "integer",
            "description": "Number of columns"
          },
          "x": {
            "type": "number",
            "description": "X position in points",
            "default": 50
          },
          "y": {
            "type": "number",
            "description": "Y position in points",
            "default": 50
          },
          "width": {
            "type": "number",
            "description": "Width in points",
            "default": 600
          },
          "height": {
            "type": "number",
            "description": "Height in points",
            "default": 400
          },
          "data": {
            "type": "array",
            "description": "Optional 2D array of cell data [[row1], [row2], ...]",
            "items": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "required": ["presentation_id", "slide_id", "rows", "columns"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "table_id": {"type": "string"},
          "rows": {"type": "integer"},
          "columns": {"type": "integer"},
          "position": {"type": "object"},
          "size": {"type": "object"}
        }
      }
    },
    {
      "name": "google_slides_insert_chart_from_sheets",
      "description": "Insert chart from Google Sheets (linked)",
      "parameters": {
        "type": "object",
        "properties": {
          "presentation_id": {
            "type": "string",
            "description": "Presentation ID"
          },
          "slide_id": {
            "type": "string",
            "description": "Slide ID"
          },
          "spreadsheet_id": {
            "type": "string",
            "description": "Source Google Sheets spreadsheet ID"
          },
          "chart_id": {
            "type": "integer",
            "description": "Chart ID from the spreadsheet"
          },
          "x": {
            "type": "number",
            "description": "X position in points",
            "default": 50
          },
          "y": {
            "type": "number",
            "description": "Y position in points",
            "default": 50
          },
          "width": {
            "type": "number",
            "description": "Width in points",
            "default": 500
          },
          "height": {
            "type": "number",
            "description": "Height in points",
            "default": 300
          }
        },
        "required": ["presentation_id", "slide_id", "spreadsheet_id", "chart_id"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "chart_id": {"type": "string"},
          "spreadsheet_id": {"type": "string"},
          "source_chart_id": {"type": "integer"},
          "position": {"type": "object"},
          "size": {"type": "object"}
        }
      }
    },
    {
      "name": "google_slides_export_as_pdf",
