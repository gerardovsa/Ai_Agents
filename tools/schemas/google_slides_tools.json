        "type": "object",
        "properties": {
          "presentation_id": {
            "type": "string",
            "description": "Presentation ID"
          }
        },
        "required": ["presentation_id"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "data": {"type": "string", "description": "Base64 encoded PPTX data"},
          "mime_type": {"type": "string"},
          "size": {"type": "integer"}
        }
      }
    },
    {
      "name": "google_slides_create_pitch_deck",
      "description": "🎯 SMART ACTION: Create complete pitch deck with 11 slides (Problem, Solution, Market, Product, Business Model, Traction, Team, Financials, Ask, Contact). Professional formatting and branding.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Presentation title"
          },
          "company_name": {
            "type": "string",
            "description": "Company name for branding"
          },
          "sections_data": {
            "type": "object",
            "description": "Data for each section",
            "properties": {
              "problem": {"type": "string", "description": "Problem statement"},
              "solution": {"type": "string", "description": "Your solution"},
              "market_size": {
                "type": "object",
                "properties": {
                  "tam": {"type": "string", "description": "Total Addressable Market"},
                  "sam": {"type": "string", "description": "Serviceable Available Market"},
                  "som": {"type": "string", "description": "Serviceable Obtainable Market"}
                }
              },
              "product": {"type": "string", "description": "Product description"},
              "business_model": {"type": "string", "description": "How you make money"},
              "traction": {
                "type": "array",
                "description": "Traction metrics",
                "items": {
                  "type": "object",
                  "properties": {
                    "metric": {"type": "string"},
                    "value": {"type": "string"}
                  }
                }
              },
              "team": {
                "type": "array",
                "description": "Team members",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {"type": "string"},
                    "role": {"type": "string"},
                    "bio": {"type": "string"}
                  }
                }
              },
              "financials": {
                "type": "object",
                "properties": {
                  "revenue": {"type": "string"},
                  "growth": {"type": "string"},
                  "runway": {"type": "string"}
                }
              },
              "ask": {"type": "string", "description": "Funding ask"},
              "contact": {
                "type": "object",
                "properties": {
                  "email": {"type": "string"},
                  "phone": {"type": "string"},
                  "website": {"type": "string"}
                }
              }
            }
          },
          "brand_color": {
            "type": "string",
            "description": "Primary brand color hex (#RRGGBB)",
            "default": "#4285F4"
          },
          "logo_url": {
            "type": "string",
            "description": "Optional company logo URL"
          }
        },
        "required": ["title", "company_name", "sections_data"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "presentation_id": {"type": "string"},
          "url": {"type": "string"},
          "title": {"type": "string"},
          "slide_count": {"type": "integer"},
          "sections": {"type": "array"}
        }
      }
    },
    {
      "name": "google_slides_create_training_presentation",
      "description": "🎯 SMART ACTION: Create training presentation with multiple modules (objectives, content, examples, exercises, takeaways). Each module gets 6 slides.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Presentation title"
          },
          "course_name": {
            "type": "string",
            "description": "Course name"
          },
          "modules_data": {
            "type": "array",
            "description": "Array of training modules",
            "items": {
              "type": "object",
              "properties": {
                "module_title": {"type": "string"},
                "objectives": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "content": {"type": "string"},
                "examples": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "exercise": {"type": "string"},
                "key_takeaways": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              }
            }
          },
          "brand_color": {
            "type": "string",
            "description": "Course theme color hex (#RRGGBB)",
            "default": "#0F9D58"
          }
        },
        "required": ["title", "course_name", "modules_data"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "presentation_id": {"type": "string"},
          "url": {"type": "string"},
          "title": {"type": "string"},
          "slide_count": {"type": "integer"},
          "module_count": {"type": "integer"}
        }
      }
    },
    {
      "name": "google_slides_create_business_report",
      "description": "🎯 SMART ACTION: Create business report with executive summary, key metrics dashboard, performance analysis, challenges, opportunities, action items. Optionally includes charts from Google Sheets.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Report title"
          },
          "report_date": {
            "type": "string",
            "description": "Report period (e.g., 'Q4 2025')"
          },
          "sections_data": {
            "type": "object",
            "description": "Report sections data",
            "properties": {
              "executive_summary": {"type": "string"},
              "key_metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {"type": "string"},
                    "value": {"type": "string"},
                    "change": {"type": "string", "description": "e.g., '+15%' or '-5%'"}
                  }
                }
              },
              "performance": {"type": "string"},
              "challenges": {"type": "string"},
              "opportunities": {"type": "string"},
              "action_items": {
                "type": "array",
                "items": {"type": "string"}
              },
              "next_steps": {"type": "string"}
            }
          },
          "charts_data": {
            "type": "array",
            "description": "Optional charts from Google Sheets",
            "items": {
              "type": "object",
              "properties": {
                "spreadsheet_id": {"type": "string"},
                "chart_id": {"type": "integer"},
                "title": {"type": "string"}
              }
            }
          },
          "brand_color": {
            "type": "string",
            "description": "Brand color hex (#RRGGBB)",
            "default": "#EA4335"
          }
        },
        "required": ["title", "report_date", "sections_data"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "presentation_id": {"type": "string"},
          "url": {"type": "string"},
          "title": {"type": "string"},
          "slide_count": {"type": "integer"},
          "chart_count": {"type": "integer"}
        }
      }
    },
    {
      "name": "google_docs_to_slides_auto_generate",
      "description": "🎯 SMART ACTION: Auto-generate presentation slides from Google Doc content. Intelligently converts long-form document into short-form slides with automatic section detection, bullet extraction, and formatting. Perfect for converting reports to presentations, creating slides while writing docs, or transforming documentation into training decks.",
      "parameters": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string",
            "description": "Google Doc ID to convert to slides"
          },
          "presentation_title": {
            "type": "string",
            "description": "Optional: Title for presentation (uses doc title if not provided)"
          },
          "slide_style": {
            "type": "string",
            "enum": ["modern", "minimal", "corporate", "creative"],
            "description": "Visual style theme for slides",
            "default": "modern"
          },
          "auto_create_sections": {
            "type": "boolean",
            "description": "Automatically detect sections from headings",
            "default": true
          },
          "include_bullet_lists": {
            "type": "boolean",
            "description": "Extract bullet points to dedicated slides",
            "default": true
          },
          "include_images": {
            "type": "boolean",
            "description": "Include images from document (future enhancement)",
            "default": true
          },
          "include_tables": {
            "type": "boolean",
            "description": "Include tables from document (future enhancement)",
            "default": true
          },
          "max_text_per_slide": {
            "type": "integer",
            "description": "Maximum characters per content slide (auto-chunks longer content)",
            "default": 300
          },
          "brand_color": {
            "type": "string",
            "description": "Primary brand color hex code (#RRGGBB)",
            "default": "#1a73e8"
          },
          "template_id": {
            "type": "string",
            "description": "Optional: Template presentation ID for consistent branding"
          }
        },
        "required": ["doc_id"]
      },
      "returns": {
        "type": "object",
        "properties": {
          "presentation_id": {"type": "string", "description": "Created presentation ID"},
          "url": {"type": "string", "description": "Presentation edit URL"},
          "title": {"type": "string", "description": "Presentation title"},
          "slide_count": {"type": "integer", "description": "Total slides created"},
          "sections_created": {"type": "integer", "description": "Number of section dividers"},
          "doc_id": {"type": "string", "description": "Source document ID"},
          "doc_url": {"type": "string", "description": "Source document URL"},
          "conversion_summary": {
            "type": "object",
            "properties": {
              "headings": {"type": "integer", "description": "Headings detected"},
              "paragraphs": {"type": "integer", "description": "Paragraphs processed"},
              "lists": {"type": "integer", "description": "Lists extracted"},
              "images": {"type": "integer", "description": "Images included"},
              "tables": {"type": "integer", "description": "Tables included"}
            }
          }
        }
      }
    }
  ]
}

