{
  "platform": "google_calendar",
  "description": "Google Calendar API - Complete calendar and event management tools",
  "tools": [
    {
      "name": "google_calendar_list_calendars",
      "description": "List all calendars accessible by the user",
      "platform": "google_calendar",
      "parameters": {
        "show_hidden": {
          "type": "boolean",
          "description": "Include hidden calendars",
          "required": false,
          "default": false
        }
      },
      "returns": {
        "type": "object",
        "description": "List of calendars with IDs and metadata"
      }
    },
    {
      "name": "google_calendar_get_calendar",
      "description": "Get details of a specific calendar",
      "platform": "google_calendar",
      "parameters": {
        "calendar_id": {
          "type": "string",
          "description": "Calendar ID (use 'primary' for main calendar)",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Calendar details including settings"
      }
    },
    {
      "name": "google_calendar_create_event",
      "description": "Create a new calendar event",
      "platform": "google_calendar",
      "parameters": {
        "calendar_id": {
          "type": "string",
          "description": "Calendar ID (use 'primary' for main calendar)",
          "required": false,
          "default": "primary"
        },
        "summary": {
          "type": "string",
          "description": "Event title/summary",
          "required": true
        },
        "description": {
          "type": "string",
          "description": "Event description",
          "required": false
        },
        "start_datetime": {
          "type": "string",
          "description": "Start date/time (ISO 8601 format: 2025-10-23T10:00:00-07:00)",
          "required": true
        },
        "end_datetime": {
          "type": "string",
          "description": "End date/time (ISO 8601 format)",
          "required": true
        },
        "timezone": {
          "type": "string",
          "description": "Timezone (e.g., 'America/New_York', 'Australia/Sydney')",
          "required": false,
          "default": "UTC"
        },
        "location": {
          "type": "string",
          "description": "Event location",
          "required": false
        },
        "attendees": {
          "type": "array",
          "description": "Array of attendee email addresses",
          "required": false
        },
        "reminders": {
          "type": "object",
          "description": "Reminder settings with minutes before event",
          "required": false
        },
        "recurrence": {
          "type": "array",
          "description": "Recurrence rules (RRULE format)",
          "required": false
        },
        "color_id": {
          "type": "string",
          "description": "Event color ID (1-11)",
          "required": false
        },
        "send_notifications": {
          "type": "boolean",
          "description": "Send email notifications to attendees",
          "required": false,
          "default": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Created event with ID and details"
      }
    },
    {
      "name": "google_calendar_update_event",
      "description": "Update an existing calendar event",
      "platform": "google_calendar",
      "parameters": {
        "calendar_id": {
          "type": "string",
          "description": "Calendar ID",
          "required": false,
          "default": "primary"
        },
        "event_id": {
          "type": "string",
          "description": "Event ID to update",
          "required": true
        },
        "summary": {
          "type": "string",
          "description": "New event title",
          "required": false
        },
        "description": {
          "type": "string",
          "description": "New description",
          "required": false
        },
        "start_datetime": {
          "type": "string",
          "description": "New start date/time",
          "required": false
        },
        "end_datetime": {
          "type": "string",
          "description": "New end date/time",
          "required": false
        },
        "location": {
          "type": "string",
          "description": "New location",
          "required": false
        },
        "attendees": {
          "type": "array",
          "description": "Updated attendee list",
          "required": false
        },
        "send_notifications": {
          "type": "boolean",
          "description": "Send update notifications",
          "required": false,
          "default": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Updated event details"
      }
    },
    {
      "name": "google_calendar_delete_event",
      "description": "Delete a calendar event",
      "platform": "google_calendar",
      "parameters": {
        "calendar_id": {
          "type": "string",
          "description": "Calendar ID",
          "required": false,
          "default": "primary"
        },
        "event_id": {
          "type": "string",
          "description": "Event ID to delete",
          "required": true
        },
        "send_notifications": {
          "type": "boolean",
          "description": "Send cancellation notifications",
          "required": false,
          "default": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Deletion confirmation"
      }
    },
    {
      "name": "google_calendar_list_events",
      "description": "List events in a calendar with filters",
      "platform": "google_calendar",
      "parameters": {
        "calendar_id": {
          "type": "string",
          "description": "Calendar ID",
          "required": false,
          "default": "primary"
        },
        "time_min": {
          "type": "string",
          "description": "Start of time range (ISO 8601)",
          "required": false
        },
        "time_max": {
          "type": "string",
          "description": "End of time range (ISO 8601)",
          "required": false
        },
        "max_results": {
          "type": "integer",
          "description": "Maximum number of events (1-2500)",
          "required": false,
          "default": 250
        },
        "single_events": {
          "type": "boolean",
          "description": "Expand recurring events into instances",
          "required": false,
          "default": true
        },
        "order_by": {
          "type": "string",
          "description": "Sort order: startTime or updated",
          "required": false,
          "default": "startTime"
        },
        "search_query": {
          "type": "string",
          "description": "Search term to filter events",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "List of events with details"
      }
    },
    {
      "name": "google_calendar_get_event",
      "description": "Get details of a specific event",
      "platform": "google_calendar",
      "parameters": {
        "calendar_id": {
          "type": "string",
          "description": "Calendar ID",
          "required": false,
          "default": "primary"
        },
        "event_id": {
          "type": "string",
          "description": "Event ID",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Event details including attendees, reminders"
      }
    },
    {
      "name": "google_calendar_check_availability",
      "description": "Check free/busy information for calendars",
      "platform": "google_calendar",
      "parameters": {
        "time_min": {
          "type": "string",
          "description": "Start of time range (ISO 8601)",
          "required": true
        },
        "time_max": {
          "type": "string",
          "description": "End of time range (ISO 8601)",
          "required": true
        },
        "calendar_ids": {
          "type": "array",
          "description": "Array of calendar IDs to check",
          "required": true
        },
        "timezone": {
          "type": "string",
          "description": "Timezone for results",
          "required": false,
          "default": "UTC"
        }
      },
      "returns": {
        "type": "object",
        "description": "Free/busy periods for each calendar"
      }
    },
    {
      "name": "google_calendar_quick_add",
      "description": "Create event from natural language text",
      "platform": "google_calendar",
      "parameters": {
        "calendar_id": {
          "type": "string",
          "description": "Calendar ID",
          "required": false,
          "default": "primary"
        },
        "text": {
          "type": "string",
          "description": "Natural language event description (e.g., 'Team meeting tomorrow at 2pm')",
          "required": true
        },
        "send_notifications": {
          "type": "boolean",
          "description": "Send notifications",
          "required": false,
          "default": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Created event from parsed text"
      }
    },
    {
      "name": "google_calendar_move_event",
      "description": "Move event to another calendar",
      "platform": "google_calendar",
      "parameters": {
        "source_calendar_id": {
          "type": "string",
          "description": "Source calendar ID",
          "required": true
        },
        "destination_calendar_id": {
          "type": "string",
          "description": "Destination calendar ID",
          "required": true
        },
        "event_id": {
          "type": "string",
          "description": "Event ID to move",
          "required": true
        },
        "send_notifications": {
          "type": "boolean",
          "description": "Send notifications",
          "required": false,
          "default": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Moved event in new calendar"
      }
    },
    {
      "name": "google_calendar_add_reminder",
      "description": "Add or update reminders for an event",
      "platform": "google_calendar",
      "parameters": {
        "calendar_id": {
          "type": "string",
          "description": "Calendar ID",
          "required": false,
          "default": "primary"
        },
        "event_id": {
          "type": "string",
          "description": "Event ID",
          "required": true
        },
        "reminders": {
          "type": "array",
          "description": "Array of reminder objects with method (email/popup) and minutes",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Updated event with new reminders"
      },
      "examples": [
        {
          "description": "Add email reminder 1 day before event",
          "parameters": {
            "event_id": "abc123",
            "reminders": [
              {"method": "email", "minutes": 1440}
            ]
          }
        }
      ]
    },
    {
      "name": "google_calendar_get_colors",
      "description": "Get available calendar and event colors",
      "platform": "google_calendar",
      "parameters": {},
      "returns": {
        "type": "object",
        "description": "Available color IDs and hex values"
      }
    }
  ]
}
