          "required": true
        },
        "start_date": {
          "type": "string",
          "description": "Start date",
          "required": true
        },
        "end_date": {
          "type": "string",
          "description": "End date",
          "required": true
        },
        "dimensions": {
          "type": "array",
          "description": "Group by dimensions (country, city, deviceCategory, etc.)",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "User behavior metrics"
      }
    },
