{
  "platform": "google_analytics",
  "description": "Google Analytics API - Web analytics, tracking, and reporting tools",
  "tools": [
    {
      "name": "google_analytics_list_accounts",
      "description": "List all Google Analytics accounts accessible",
      "platform": "google_analytics",
      "parameters": {},
      "returns": {
        "type": "object",
        "description": "List of Analytics accounts"
      }
    },
    {
      "name": "google_analytics_list_properties",
      "description": "List properties for an account",
      "platform": "google_analytics",
      "parameters": {
        "account_id": {
          "type": "string",
          "description": "Account ID",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "List of properties (GA4 and Universal Analytics)"
      }
    },
    {
      "name": "google_analytics_get_realtime_report",
      "description": "Get real-time analytics data (last 30 minutes)",
      "platform": "google_analytics",
      "parameters": {
        "property_id": {
          "type": "string",
          "description": "GA4 property ID",
          "required": true
        },
        "dimensions": {
          "type": "array",
          "description": "Dimensions to include (e.g., ['country', 'deviceCategory'])",
          "required": false
        },
        "metrics": {
          "type": "array",
          "description": "Metrics to include (e.g., ['activeUsers', 'screenPageViews'])",
          "required": true
        },
        "limit": {
          "type": "integer",
          "description": "Maximum rows to return",
          "required": false,
          "default": 100
        }
      },
      "returns": {
        "type": "object",
        "description": "Real-time analytics data"
      }
    },
    {
      "name": "google_analytics_run_report",
      "description": "Run a custom analytics report",
      "platform": "google_analytics",
      "parameters": {
        "property_id": {
          "type": "string",
          "description": "GA4 property ID",
          "required": true
        },
        "date_ranges": {
          "type": "array",
          "description": "Array of date range objects with startDate and endDate",
          "required": true
        },
        "dimensions": {
          "type": "array",
          "description": "Dimensions (e.g., ['date', 'country', 'pagePath'])",
          "required": false
        },
        "metrics": {
          "type": "array",
          "description": "Metrics (e.g., ['sessions', 'totalUsers', 'bounceRate'])",
          "required": true
        },
        "dimension_filter": {
          "type": "object",
          "description": "Filter to apply to dimensions",
          "required": false
        },
        "metric_filter": {
          "type": "object",
          "description": "Filter to apply to metrics",
          "required": false
        },
        "order_bys": {
          "type": "array",
          "description": "Sort order specifications",
          "required": false
        },
        "limit": {
          "type": "integer",
          "description": "Maximum rows",
          "required": false,
          "default": 1000
        },
        "offset": {
          "type": "integer",
          "description": "Row offset for pagination",
          "required": false,
          "default": 0
        }
      },
      "returns": {
        "type": "object",
        "description": "Report data with dimensions and metrics"
      }
    },
    {
      "name": "google_analytics_get_page_views",
      "description": "Get page view statistics for a date range",
      "platform": "google_analytics",
      "parameters": {
        "property_id": {
          "type": "string",
          "description": "GA4 property ID",
          "required": true
        },
        "start_date": {
          "type": "string",
          "description": "Start date (YYYY-MM-DD or 'today', '7daysAgo', etc.)",
          "required": true
        },
        "end_date": {
          "type": "string",
          "description": "End date (YYYY-MM-DD or 'today')",
          "required": true
        },
        "page_path": {
          "type": "string",
          "description": "Filter by specific page path",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Page view metrics by date and page"
      }
    },
    {
      "name": "google_analytics_get_user_behavior",
