{
  "platform": "stripe",
  "description": "Stripe Payment API - Complete payment processing, subscriptions, invoices, refunds, and customer management",
  "tools": [
    {
      "name": "stripe_create_payment_intent",
      "description": "Create a payment intent for card payments",
      "platform": "stripe",
      "parameters": {
        "amount": {
          "type": "integer",
          "description": "Amount in smallest currency unit (e.g., cents for USD)",
          "required": true
        },
        "currency": {
          "type": "string",
          "description": "Three-letter ISO currency code (e.g., 'usd', 'eur', 'gbp')",
          "required": true
        },
        "customer_id": {
          "type": "string",
          "description": "Stripe customer ID",
          "required": false
        },
        "description": {
          "type": "string",
          "description": "Payment description",
          "required": false
        },
        "metadata": {
          "type": "object",
          "description": "Custom metadata key-value pairs",
          "required": false
        },
        "payment_method_types": {
          "type": "array",
          "description": "Payment methods to accept (e.g., ['card', 'alipay'])",
          "required": false,
          "default": ["card"]
        },
        "receipt_email": {
          "type": "string",
          "description": "Email address for receipt",
          "required": false
        },
        "automatic_payment_methods": {
          "type": "boolean",
          "description": "Enable automatic payment method detection",
          "required": false,
          "default": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Payment intent object with client secret"
      }
    },
    {
      "name": "stripe_confirm_payment",
      "description": "Confirm a payment intent",
      "platform": "stripe",
      "parameters": {
        "payment_intent_id": {
          "type": "string",
          "description": "Payment intent ID",
          "required": true
        },
        "payment_method": {
          "type": "string",
          "description": "Payment method ID",
          "required": false
        },
        "return_url": {
          "type": "string",
          "description": "URL to redirect after authentication",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Confirmed payment intent"
      }
    },
    {
      "name": "stripe_capture_payment",
      "description": "Capture an authorized payment",
      "platform": "stripe",
      "parameters": {
        "payment_intent_id": {
          "type": "string",
          "description": "Payment intent ID",
          "required": true
        },
        "amount_to_capture": {
          "type": "integer",
          "description": "Amount to capture (optional, defaults to full authorized amount)",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Captured payment intent"
      }
    },
    {
      "name": "stripe_create_refund",
      "description": "Create a refund for a payment",
      "platform": "stripe",
      "parameters": {
        "payment_intent_id": {
          "type": "string",
          "description": "Payment intent ID to refund",
          "required": true
        },
        "amount": {
          "type": "integer",
          "description": "Amount to refund (omit for full refund)",
          "required": false
        },
        "reason": {
          "type": "string",
          "description": "Reason: duplicate, fraudulent, or requested_by_customer",
          "required": false
        },
        "metadata": {
          "type": "object",
          "description": "Custom metadata",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Refund object with status"
      }
    },
    {
      "name": "stripe_list_refunds",
      "description": "List all refunds",
      "platform": "stripe",
      "parameters": {
        "payment_intent_id": {
          "type": "string",
          "description": "Filter by payment intent ID",
          "required": false
        },
        "limit": {
          "type": "integer",
          "description": "Number of refunds to return (1-100)",
          "required": false,
          "default": 10
        }
      },
      "returns": {
        "type": "object",
        "description": "List of refunds"
      }
    },
    {
      "name": "stripe_create_customer",
      "description": "Create a new customer",
      "platform": "stripe",
      "parameters": {
        "email": {
          "type": "string",
          "description": "Customer email",
          "required": true
        },
        "name": {
          "type": "string",
          "description": "Customer name",
          "required": false
        },
        "phone": {
          "type": "string",
          "description": "Customer phone",
          "required": false
        },
        "description": {
          "type": "string",
          "description": "Customer description",
          "required": false
        },
        "metadata": {
          "type": "object",
          "description": "Custom metadata",
          "required": false
        },
        "payment_method": {
          "type": "string",
          "description": "Payment method ID to attach",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Customer object with ID"
      }
    },
    {
      "name": "stripe_get_customer",
      "description": "Retrieve customer details",
      "platform": "stripe",
      "parameters": {
        "customer_id": {
          "type": "string",
          "description": "Customer ID",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Customer details"
      }
    },
    {
      "name": "stripe_update_customer",
      "description": "Update customer information",
      "platform": "stripe",
      "parameters": {
        "customer_id": {
          "type": "string",
          "description": "Customer ID",
          "required": true
        },
        "email": {
          "type": "string",
          "description": "New email",
          "required": false
        },
        "name": {
          "type": "string",
          "description": "New name",
          "required": false
        },
        "phone": {
          "type": "string",
          "description": "New phone",
          "required": false
        },
        "metadata": {
          "type": "object",
          "description": "Updated metadata",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Updated customer"
      }
    },
    {
      "name": "stripe_delete_customer",
      "description": "Delete a customer",
      "platform": "stripe",
      "parameters": {
        "customer_id": {
          "type": "string",
          "description": "Customer ID",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Deletion confirmation"
      }
    },
    {
      "name": "stripe_list_customers",
      "description": "List all customers",
      "platform": "stripe",
      "parameters": {
        "email": {
          "type": "string",
          "description": "Filter by email",
          "required": false
        },
        "limit": {
          "type": "integer",
          "description": "Number of customers (1-100)",
          "required": false,
          "default": 10
        }
      },
      "returns": {
        "type": "object",
        "description": "List of customers"
      }
    },
    {
      "name": "stripe_create_subscription",
      "description": "Create a subscription for a customer",
      "platform": "stripe",
      "parameters": {
        "customer_id": {
          "type": "string",
          "description": "Customer ID",
          "required": true
        },
        "items": {
          "type": "array",
          "description": "Array of subscription items with price IDs",
          "required": true
        },
        "trial_period_days": {
          "type": "integer",
          "description": "Trial period in days",
          "required": false
        },
        "metadata": {
          "type": "object",
          "description": "Custom metadata",
          "required": false
        },
        "proration_behavior": {
          "type": "string",
          "description": "Proration behavior: create_prorations or none",
          "required": false,
          "default": "create_prorations"
        }
      },
      "returns": {
        "type": "object",
        "description": "Subscription object"
      }
    },
    {
      "name": "stripe_update_subscription",
      "description": "Update an existing subscription",
      "platform": "stripe",
      "parameters": {
        "subscription_id": {
          "type": "string",
          "description": "Subscription ID",
          "required": true
        },
        "items": {
          "type": "array",
          "description": "Updated subscription items",
          "required": false
        },
        "cancel_at_period_end": {
          "type": "boolean",
          "description": "Cancel at end of current period",
          "required": false
        },
        "metadata": {
          "type": "object",
          "description": "Updated metadata",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Updated subscription"
      }
    },
    {
      "name": "stripe_cancel_subscription",
