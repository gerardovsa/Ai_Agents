      "parameters": {
        "invoice_id": {
          "type": "string",
          "description": "Invoice ID",
          "required": true
        },
        "auto_advance": {
          "type": "boolean",
          "description": "Automatically attempt payment",
          "required": false,
          "default": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Finalized invoice"
      }
    },
    {
      "name": "stripe_pay_invoice",
