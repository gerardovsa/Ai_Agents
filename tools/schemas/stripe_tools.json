      "platform": "stripe",
      "parameters": {
        "subscription_id": {
          "type": "string",
          "description": "Subscription ID",
          "required": true
        },
        "at_period_end": {
          "type": "boolean",
          "description": "Cancel at end of period (vs immediately)",
          "required": false,
          "default": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Cancelled subscription"
      }
    },
    {
      "name": "stripe_list_subscriptions",
      "description": "List subscriptions",
      "platform": "stripe",
      "parameters": {
        "customer_id": {
          "type": "string",
          "description": "Filter by customer ID",
          "required": false
        },
        "status": {
          "type": "string",
          "description": "Filter by status: active, canceled, past_due, etc.",
          "required": false
        },
        "limit": {
          "type": "integer",
          "description": "Number to return (1-100)",
          "required": false,
          "default": 10
        }
      },
      "returns": {
        "type": "object",
        "description": "List of subscriptions"
      }
    },
    {
      "name": "stripe_create_invoice",
