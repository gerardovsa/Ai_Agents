{
  "platform": "microsoft_onedrive",
  "description": "Microsoft OneDrive - Cloud file storage, sharing, synchronization, and collaboration",
  "version": "1.0.0",
  "tools": [
    {
      "name": "onedrive_list_files",
      "description": "List files and folders in OneDrive",
      "platform": "microsoft_onedrive",
      "category": "basic",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "folder_path": {
          "type": "string",
          "description": "Folder path (root if not specified)",
          "required": false,
          "default": "root"
        },
        "max_results": {
          "type": "integer",
          "description": "Maximum number of items to return",
          "required": false,
          "default": 100
        }
      },
      "example": {
        "user_id": "user123",
        "folder_path": "Documents/Projects",
        "max_results": 50
      }
    },
    {
      "name": "onedrive_upload_file",
      "description": "Upload a file to OneDrive",
      "platform": "microsoft_onedrive",
      "category": "basic",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "file_path": {
          "type": "string",
          "description": "Local file path to upload",
          "required": true
        },
        "destination_folder": {
          "type": "string",
          "description": "OneDrive folder path (root if not specified)",
          "required": false,
          "default": "root"
        },
        "file_name": {
          "type": "string",
          "description": "Name for the file in OneDrive (uses original if not specified)",
          "required": false
        },
        "overwrite": {
          "type": "boolean",
          "description": "Whether to overwrite if file exists",
          "required": false,
          "default": true
        }
      },
      "example": {
        "user_id": "user123",
        "file_path": "/path/to/document.pdf",
        "destination_folder": "Work/Reports",
        "file_name": "Q4_Report.pdf"
      }
    },
    {
      "name": "onedrive_download_file",
      "description": "Download a file from OneDrive",
      "platform": "microsoft_onedrive",
      "category": "basic",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "file_id": {
          "type": "string",
          "description": "OneDrive file ID",
          "required": true
        },
        "local_path": {
          "type": "string",
          "description": "Local path to save file",
          "required": true
        }
      },
      "example": {
        "user_id": "user123",
        "file_id": "01ABCDEF123456789",
        "local_path": "/downloads/document.pdf"
      }
    },
    {
      "name": "onedrive_get_file_info",
      "description": "Get detailed information about a file or folder",
      "platform": "microsoft_onedrive",
      "category": "basic",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "item_id": {
          "type": "string",
          "description": "File or folder ID",
          "required": true
        }
      },
      "example": {
        "user_id": "user123",
        "item_id": "01ABCDEF123456789"
      }
    },
    {
      "name": "onedrive_create_folder",
      "description": "Create a new folder in OneDrive",
      "platform": "microsoft_onedrive",
      "category": "basic",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "folder_name": {
          "type": "string",
          "description": "Name of the new folder",
          "required": true
        },
        "parent_folder": {
          "type": "string",
          "description": "Parent folder path (root if not specified)",
          "required": false,
          "default": "root"
        }
      },
      "example": {
        "user_id": "user123",
        "folder_name": "2025 Projects",
        "parent_folder": "Work"
      }
    },
    {
      "name": "onedrive_delete_item",
      "description": "Delete a file or folder from OneDrive",
      "platform": "microsoft_onedrive",
      "category": "basic",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "item_id": {
          "type": "string",
          "description": "File or folder ID to delete",
          "required": true
        }
      },
      "example": {
        "user_id": "user123",
        "item_id": "01ABCDEF123456789"
      }
    },
    {
      "name": "onedrive_move_item",
      "description": "Move a file or folder to another location",
      "platform": "microsoft_onedrive",
      "category": "basic",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "item_id": {
          "type": "string",
          "description": "File or folder ID to move",
          "required": true
        },
        "destination_folder_id": {
          "type": "string",
          "description": "Destination folder ID",
          "required": true
        },
        "new_name": {
          "type": "string",
          "description": "Optional: New name for the item",
          "required": false
        }
      },
      "example": {
        "user_id": "user123",
        "item_id": "01ABCDEF123456789",
        "destination_folder_id": "01GHIJKL987654321"
      }
    },
    {
      "name": "onedrive_copy_item",
      "description": "Copy a file or folder to another location",
      "platform": "microsoft_onedrive",
      "category": "basic",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
