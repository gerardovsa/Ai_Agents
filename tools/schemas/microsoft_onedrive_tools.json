    {
      "name": "onedrive_search_files",
      "description": "Search for files and folders in OneDrive",
      "platform": "microsoft_onedrive",
      "category": "basic",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "query": {
          "type": "string",
          "description": "Search query",
          "required": true
        },
        "max_results": {
          "type": "integer",
          "description": "Maximum number of results",
          "required": false,
          "default": 50
        }
      },
      "example": {
        "user_id": "user123",
        "query": "project report 2025",
        "max_results": 25
      }
    },
    {
      "name": "onedrive_create_share_link",
      "description": "Create a sharing link for a file or folder",
      "platform": "microsoft_onedrive",
      "category": "basic",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "item_id": {
          "type": "string",
          "description": "File or folder ID to share",
          "required": true
        },
        "link_type": {
          "type": "string",
          "description": "Link type: 'view', 'edit', 'embed'",
          "required": false,
          "default": "view"
        },
        "scope": {
          "type": "string",
          "description": "Scope: 'anonymous', 'organization'",
          "required": false,
          "default": "anonymous"
        },
        "expiration": {
          "type": "string",
          "description": "Optional: Expiration date (ISO 8601)",
          "required": false
        }
      },
      "example": {
        "user_id": "user123",
        "item_id": "01ABCDEF123456789",
        "link_type": "view",
        "scope": "organization",
        "expiration": "2025-12-31T23:59:59Z"
      }
    },
    {
      "name": "onedrive_share_with_users",
      "description": "Share a file or folder with specific users",
      "platform": "microsoft_onedrive",
      "category": "basic",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "item_id": {
          "type": "string",
          "description": "File or folder ID to share",
          "required": true
        },
        "recipients": {
          "type": "array",
          "description": "List of email addresses to share with",
          "required": true
        },
        "role": {
          "type": "string",
          "description": "Permission role: 'read', 'write', 'owner'",
          "required": false,
          "default": "read"
        },
        "message": {
          "type": "string",
          "description": "Optional message to recipients",
          "required": false
        }
      },
      "example": {
        "user_id": "user123",
        "item_id": "01ABCDEF123456789",
        "recipients": ["john@company.com", "jane@company.com"],
        "role": "write",
        "message": "Please review and provide feedback"
      }
    },
