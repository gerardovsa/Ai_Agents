        },
        "version_id": {
          "type": "string",
          "description": "Version ID to restore",
          "required": true
        }
      },
      "example": {
        "user_id": "user123",
        "file_id": "01ABCDEF123456789",
        "version_id": "2.0"
      }
    },
    {
      "name": "onedrive_get_thumbnail",
