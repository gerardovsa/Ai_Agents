      },
      "example": {
        "user_id": "user123",
        "file_id": "01ABCDEF123456789",
        "size": "large"
      }
    },
    {
      "name": "onedrive_smart_organize_by_type",
      "description": "Automatically organize files into folders by file type",
      "platform": "microsoft_onedrive",
      "category": "smart_bundled",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "source_folder": {
          "type": "string",
          "description": "Folder to organize (root if not specified)",
          "required": false,
          "default": "root"
        },
        "type_mapping": {
          "type": "object",
          "description": "Mapping of file types to destination folders",
          "required": false,
          "default": {
            "documents": ["doc", "docx", "pdf", "txt"],
            "spreadsheets": ["xls", "xlsx", "csv"],
            "presentations": ["ppt", "pptx"],
            "images": ["jpg", "jpeg", "png", "gif"],
            "videos": ["mp4", "avi", "mov"]
          }
        },
        "create_folders": {
          "type": "boolean",
          "description": "Create destination folders if they don't exist",
          "required": false,
          "default": true
        }
      },
      "example": {
        "user_id": "user123",
        "source_folder": "root",
        "type_mapping": {
          "Work Documents": ["doc", "docx", "pdf"],
          "Invoices": ["pdf"],
          "Photos": ["jpg", "png"]
        }
      }
    },
    {
      "name": "onedrive_smart_backup_folder",
      "description": "Create timestamped backup of a folder",
      "platform": "microsoft_onedrive",
      "category": "smart_bundled",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "folder_id": {
          "type": "string",
          "description": "Folder ID to backup",
          "required": true
        },
        "backup_location": {
          "type": "string",
          "description": "Where to store backup (root if not specified)",
          "required": false,
          "default": "Backups"
        },
        "include_timestamp": {
          "type": "boolean",
          "description": "Add timestamp to backup folder name",
          "required": false,
          "default": true
        }
      },
      "example": {
        "user_id": "user123",
        "folder_id": "01ABCDEF123456789",
        "backup_location": "Backups/Projects",
        "include_timestamp": true
      }
    },
    {
      "name": "onedrive_smart_cleanup_duplicates",
      "description": "Find and optionally remove duplicate files",
      "platform": "microsoft_onedrive",
      "category": "smart_bundled",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "folder_id": {
          "type": "string",
          "description": "Folder to scan for duplicates",
          "required": true
        },
        "comparison_method": {
          "type": "string",
          "description": "How to detect duplicates: 'name', 'size', 'hash'",
          "required": false,
          "default": "name"
        },
        "auto_delete": {
          "type": "boolean",
          "description": "Automatically delete duplicates (keeps newest)",
          "required": false,
          "default": false
        }
      },
      "example": {
        "user_id": "user123",
        "folder_id": "01ABCDEF123456789",
        "comparison_method": "name",
        "auto_delete": false
      }
    },
    {
      "name": "onedrive_smart_sync_folders",
      "description": "Synchronize two OneDrive folders (one-way or two-way)",
      "platform": "microsoft_onedrive",
      "category": "smart_bundled",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "source_folder_id": {
          "type": "string",
          "description": "Source folder ID",
          "required": true
        },
        "destination_folder_id": {
          "type": "string",
          "description": "Destination folder ID",
          "required": true
        },
        "sync_mode": {
          "type": "string",
          "description": "Sync mode: 'one_way', 'two_way'",
          "required": false,
          "default": "one_way"
        },
        "delete_extra": {
          "type": "boolean",
          "description": "Delete files in destination not in source",
          "required": false,
          "default": false
        }
      },
      "example": {
        "user_id": "user123",
        "source_folder_id": "01ABCDEF123456789",
        "destination_folder_id": "01GHIJKL987654321",
        "sync_mode": "one_way"
      }
    },
