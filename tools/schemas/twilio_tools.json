        "to": {
          "type": "string",
          "description": "Filter by recipient phone number",
          "required": false
        },
        "from": {
          "type": "string",
          "description": "Filter by sender phone number",
          "required": false
        },
        "date_sent": {
          "type": "string",
          "description": "Filter by date sent (YYYY-MM-DD)",
          "required": false
        },
        "limit": {
          "type": "integer",
          "description": "Number of messages to return (1-1000)",
          "required": false,
          "default": 50
        }
      },
      "returns": {
        "type": "object",
        "description": "List of messages"
      }
