{
  "platform": "twilio",
  "description": "Twilio Communications API - SMS, voice calls, WhatsApp, video, and email via SendGrid",
  "tools": [
    {
      "name": "twilio_send_sms",
      "description": "Example response:\nCreated: **New Document**\n- ID: `abc123`\n- URL: https://example.com/doc/abc123\n- Link: [New Document](https://example.com/doc/abc123)\n\nSend an SMS message",
      "platform": "twilio",
      "parameters": {
        "to": {
          "type": "string",
          "description": "Recipient phone number (E.164 format: +1234567890)",
          "required": true
        },
        "from": {
          "type": "string",
          "description": "Twilio phone number (E.164 format)",
          "required": true
        },
        "body": {
          "type": "string",
          "description": "Message body (up to 1600 characters)",
          "required": true
        },
        "media_url": {
          "type": "array",
          "description": "Array of media URLs for MMS",
          "required": false
        },
        "status_callback": {
          "type": "string",
          "description": "Webhook URL for delivery status",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Message SID and status"
      }
    },
    {
      "name": "twilio_get_message",
      "description": "Example response:\nRead 45 rows from **Sales Spreadsheet**\n- ID: `xyz789`\n- URL: https://example.com/sheet/xyz789\n- Data: [actual data read]\n\nGet SMS message details and status",
      "platform": "twilio",
      "parameters": {
        "message_sid": {
          "type": "string",
          "description": "Message SID",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Message details including delivery status"
      }
    },
    {
