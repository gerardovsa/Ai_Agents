{
  "platform": "microsoft_todo",
  "description": "Microsoft To Do & Planner - Task management, project planning, team assignments, and workload tracking",
  "version": "1.0.0",
  "tools": [
    {
      "name": "todo_list_tasks",
      "description": "List tasks from To Do",
      "platform": "microsoft_todo",
      "category": "basic",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "list_id": {
          "type": "string",
          "description": "Task list ID (default list if not specified)",
          "required": false
        },
        "filter": {
          "type": "string",
          "description": "Filter: 'all', 'completed', 'incomplete', 'today', 'important'",
          "required": false,
          "default": "incomplete"
        },
        "max_results": {
          "type": "integer",
          "description": "Maximum number of tasks to return",
          "required": false,
          "default": 100
        }
      },
      "example": {
        "user_id": "user123",
        "list_id": "AAMkAGI...",
        "filter": "today",
        "max_results": 50
      }
    },
    {
      "name": "todo_create_task",
      "description": "Create a new task in To Do",
      "platform": "microsoft_todo",
      "category": "basic",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "title": {
          "type": "string",
          "description": "Task title",
          "required": true
        },
        "list_id": {
          "type": "string",
          "description": "Task list ID (default list if not specified)",
          "required": false
        },
        "due_date": {
          "type": "string",
          "description": "Due date (ISO 8601 format)",
          "required": false
        },
        "reminder": {
          "type": "string",
          "description": "Reminder date/time (ISO 8601 format)",
          "required": false
        },
        "importance": {
          "type": "string",
          "description": "Importance: 'low', 'normal', 'high'",
          "required": false,
          "default": "normal"
        },
        "body": {
          "type": "string",
          "description": "Task description/notes",
          "required": false
        }
      },
      "example": {
        "user_id": "user123",
        "title": "Review project proposal",
        "due_date": "2025-10-31T17:00:00Z",
        "importance": "high",
        "body": "Focus on budget and timeline sections"
      }
    },
    {
      "name": "todo_update_task",
      "description": "Update an existing task",
      "platform": "microsoft_todo",
      "category": "basic",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "task_id": {
          "type": "string",
          "description": "Task ID to update",
          "required": true
        },
        "updates": {
          "type": "object",
          "description": "Fields to update",
          "required": true
        }
      },
      "example": {
        "user_id": "user123",
        "task_id": "AAMkAGI...",
        "updates": {
          "title": "Updated: Review proposal",
          "due_date": "2025-11-01T17:00:00Z",
          "status": "in_progress"
        }
      }
    },
