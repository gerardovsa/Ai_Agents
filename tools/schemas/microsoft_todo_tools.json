          "required": true
        },
        "task_id": {
          "type": "string",
          "description": "Task ID",
          "required": true
        },
        "assignees": {
          "type": "array",
          "description": "List of user IDs to assign",
          "required": true
        }
      },
      "example": {
        "user_id": "user123",
        "task_id": "01gzSlKkduf...",
        "assignees": ["john@company.com", "jane@company.com"]
      }
    },
    {
      "name": "planner_add_checklist",
