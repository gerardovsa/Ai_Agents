    {
      "name": "planner_create_task",
      "description": "Create a task in Planner",
      "platform": "microsoft_todo",
      "category": "basic",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "plan_id": {
          "type": "string",
          "description": "Plan ID",
          "required": true
        },
        "bucket_id": {
          "type": "string",
          "description": "Bucket ID",
          "required": true
        },
        "title": {
          "type": "string",
          "description": "Task title",
          "required": true
        },
        "assignments": {
          "type": "array",
          "description": "List of user IDs to assign task to",
          "required": false
        },
        "due_date": {
          "type": "string",
          "description": "Due date (ISO 8601 format)",
          "required": false
        },
        "priority": {
          "type": "integer",
          "description": "Priority: 1-10 (1=urgent, 5=medium, 9=low)",
          "required": false,
          "default": 5
        }
      },
      "example": {
        "user_id": "user123",
        "plan_id": "xqQg5FS2LkCp935s-BuFRmUAFfbg",
        "bucket_id": "hsOf2dhoh02QT52nf-ZdbZcAKABg",
        "title": "Design homepage mockup",
        "assignments": ["john@company.com"],
        "due_date": "2025-11-05T17:00:00Z",
        "priority": 3
      }
    },
    {
      "name": "planner_update_task",
      "description": "Update a Planner task",
      "platform": "microsoft_todo",
      "category": "basic",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "task_id": {
          "type": "string",
          "description": "Task ID",
          "required": true
        },
        "updates": {
          "type": "object",
          "description": "Fields to update",
          "required": true
        }
      },
      "example": {
        "user_id": "user123",
        "task_id": "01gzSlKkduf...",
        "updates": {
          "percent_complete": 50,
          "bucket_id": "new-bucket-id"
        }
      }
    },
    {
