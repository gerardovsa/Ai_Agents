        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "task_id": {
          "type": "string",
          "description": "Task ID",
          "required": true
        },
        "checklist_items": {
          "type": "array",
          "description": "List of checklist item titles",
          "required": true
        }
      },
      "example": {
        "user_id": "user123",
        "task_id": "01gzSlKkduf...",
        "checklist_items": [
          "Research competitors",
          "Create wireframes",
          "Get feedback from team"
        ]
      }
    },
    {
      "name": "todo_smart_daily_digest",
      "description": "Generate daily task digest with priorities and due dates",
      "platform": "microsoft_todo",
      "category": "smart_bundled",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "include_overdue": {
          "type": "boolean",
          "description": "Include overdue tasks",
          "required": false,
          "default": true
        },
        "include_upcoming": {
          "type": "boolean",
          "description": "Include tasks due in next 7 days",
          "required": false,
          "default": true
        },
        "format": {
          "type": "string",
          "description": "Output format: 'text', 'html', 'markdown'",
          "required": false,
          "default": "html"
        }
      },
      "example": {
        "user_id": "user123",
        "include_overdue": true,
        "include_upcoming": true,
        "format": "html"
      }
    },
    {
      "name": "planner_smart_sprint_setup",
      "description": "Create complete sprint board with buckets and initial tasks",
      "platform": "microsoft_todo",
      "category": "smart_bundled",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "plan_name": {
          "type": "string",
          "description": "Sprint/plan name",
          "required": true
        },
        "owner_group_id": {
          "type": "string",
          "description": "Microsoft 365 Group ID",
          "required": true
        },
        "sprint_config": {
          "type": "object",
          "description": "Sprint configuration with buckets and tasks",
          "required": true
        }
      },
      "example": {
        "user_id": "user123",
        "plan_name": "Sprint 15 - October 2025",
        "owner_group_id": "12345678-1234-1234-1234-123456789abc",
        "sprint_config": {
          "buckets": ["Backlog", "In Progress", "Review", "Done"],
          "tasks": [
            {
              "title": "User authentication feature",
              "bucket": "Backlog",
              "assignee": "john@company.com",
              "priority": 1
            },
            {
              "title": "Database schema update",
              "bucket": "In Progress",
              "assignee": "jane@company.com",
              "priority": 2
            }
          ]
        }
      }
    },
    {
      "name": "planner_smart_team_workload",
      "description": "Analyze team workload and suggest task redistribution",
      "platform": "microsoft_todo",
      "category": "smart_bundled",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "plan_id": {
          "type": "string",
          "description": "Plan ID to analyze",
          "required": true
        },
        "balance_by": {
          "type": "string",
          "description": "Balance method: 'task_count', 'priority', 'estimated_hours'",
          "required": false,
          "default": "task_count"
        },
        "auto_reassign": {
          "type": "boolean",
          "description": "Automatically reassign tasks to balance workload",
          "required": false,
          "default": false
        }
      },
      "example": {
        "user_id": "user123",
        "plan_id": "xqQg5FS2LkCp935s-BuFRmUAFfbg",
        "balance_by": "priority",
        "auto_reassign": false
      }
    },
    {
      "name": "todo_smart_recurring_tasks",
      "description": "Create recurring tasks with custom patterns",
      "platform": "microsoft_todo",
      "category": "smart_bundled",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "task_template": {
          "type": "object",
          "description": "Task template with title, description, importance",
          "required": true
        },
        "recurrence": {
          "type": "object",
          "description": "Recurrence pattern (daily, weekly, monthly)",
          "required": true
        },
        "end_date": {
          "type": "string",
          "description": "When to stop creating tasks (ISO 8601)",
          "required": false
        }
      },
      "example": {
        "user_id": "user123",
        "task_template": {
          "title": "Weekly status report",
          "importance": "high",
          "body": "Prepare and send weekly team status"
        },
        "recurrence": {
          "type": "weekly",
          "day_of_week": "friday",
          "time": "17:00"
        },
        "end_date": "2025-12-31T23:59:59Z"
      }
    },
    {
      "name": "planner_get_plan_progress",
      "description": "Get progress statistics for a Planner plan",
      "platform": "microsoft_todo",
      "category": "advanced",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "plan_id": {
          "type": "string",
          "description": "Plan ID",
          "required": true
        }
      },
      "example": {
        "user_id": "user123",
        "plan_id": "xqQg5FS2LkCp935s-BuFRmUAFfbg"
      }
    },
    {
      "name": "todo_export_tasks",
      "description": "Export tasks to various formats",
      "platform": "microsoft_todo",
      "category": "advanced",
      "priority": "low",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "list_id": {
          "type": "string",
          "description": "Task list ID to export",
          "required": true
        },
        "format": {
          "type": "string",
          "description": "Export format: 'csv', 'json', 'markdown'",
          "required": false,
          "default": "csv"
        },
        "output_path": {
          "type": "string",
          "description": "Local path to save export",
          "required": true
        }
      },
      "example": {
        "user_id": "user123",
        "list_id": "AAMkAGI...",
        "format": "csv",
        "output_path": "/exports/tasks.csv"
      }
    }
  ]
}
