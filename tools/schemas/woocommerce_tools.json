{
  "platform": "woocommerce",
  "description": "WooCommerce e-commerce management tools - Complete API coverage for orders, products, customers, analytics, and store management",
  "tools": [
    {
      "name": "woocommerce_get_orders",
      "description": "Retrieve orders from WooCommerce store with advanced filtering",
      "platform": "woocommerce",
      "parameters": {
        "status": {
          "type": "string",
          "description": "Order status filter (pending, processing, on-hold, completed, cancelled, refunded, failed)",
          "required": false
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of orders to return (1-100)",
          "required": false,
          "default": 10
        },
        "page": {
          "type": "integer",
          "description": "Page number for pagination",
          "required": false,
          "default": 1
        },
        "after": {
          "type": "string",
          "description": "Limit results to orders created after given ISO8601 date",
          "required": false
        },
        "before": {
          "type": "string",
          "description": "Limit results to orders created before given ISO8601 date",
          "required": false
        },
        "customer": {
          "type": "integer",
          "description": "Filter by customer ID",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "List of orders with full details including line items, shipping, billing, and metadata"
      }
    },
