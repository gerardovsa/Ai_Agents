            "returns": {
                "type": "object",
                "description": "Batch result with all attachments processed, content_blocks array, and total token estimate"
            },
            "examples": [
                {
                    "description": "Process all attachments from Sign Doctor email",
                    "parameters": {
                        "message_id": "AAMkAGVmMDEz..."
                    }
                }
            ]
        },
        {
