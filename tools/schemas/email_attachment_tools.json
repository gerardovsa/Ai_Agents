        {
            "name": "google_gmail_process_all_attachments",
            "short_description": "Process all Gmail attachments at once - auto-fetches list, batch processing for AI",
            "description": "Process ALL attachments from a Gmail message at once. Gets attachment list automatically and processes all files in batch. Returns content_blocks ready for Anthropic API.",
            "platform": "email_attachments",
