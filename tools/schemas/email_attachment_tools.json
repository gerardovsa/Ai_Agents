                            "files_api",
                            "url"
                        ],
                        "default": "auto"
                    }
                },
                "required": [
                    "message_id",
                    "attachment_id"
                ]
            },
            "returns": {
                "type": "object",
                "description": "Anthropic-ready content_block or URL with metadata"
            }
        },
        {
            "name": "microsoft_outlook_process_all_attachments",
