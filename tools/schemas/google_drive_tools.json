{
  "platform": "google_drive",
  "description": "Google Drive API - Cloud storage, file management, and sharing tools",
  "tools": [
    {
      "name": "google_drive_list_files",
      "description": "List files and folders in Drive with filters",
      "platform": "google_drive",
      "parameters": {
        "query": {
          "type": "string",
          "description": "Search query (e.g., \"name contains 'report' and mimeType='application/pdf'\")",
          "required": false
        },
        "folder_id": {
          "type": "string",
          "description": "Specific folder ID to list (omit for root or search all)",
          "required": false
        },
        "page_size": {
          "type": "integer",
          "description": "Number of files to return (1-1000)",
          "required": false,
          "default": 100
        },
        "order_by": {
          "type": "string",
          "description": "Sort order: createdTime, modifiedTime, name, quotaBytesUsed, etc.",
          "required": false,
          "default": "modifiedTime desc"
        },
        "include_trashed": {
          "type": "boolean",
          "description": "Include trashed files",
          "required": false,
          "default": false
        }
      },
      "returns": {
        "type": "object",
        "description": "List of files with metadata"
      }
    },
    {
      "name": "google_drive_get_file",
      "description": "Get file metadata or download file content",
      "platform": "google_drive",
      "parameters": {
        "file_id": {
          "type": "string",
          "description": "File ID",
          "required": true
        },
        "download": {
          "type": "boolean",
          "description": "Download file content (vs just metadata)",
          "required": false,
          "default": false
        },
        "mime_type": {
          "type": "string",
          "description": "Export format for Google Docs (e.g., 'application/pdf', 'text/plain')",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "File metadata or content"
      }
    },
    {
      "name": "google_drive_upload_file",
      "description": "Upload a new file to Google Drive",
      "platform": "google_drive",
      "parameters": {
        "name": {
          "type": "string",
          "description": "File name",
          "required": true
        },
        "content": {
          "type": "string",
          "description": "File content (text) or base64 encoded binary",
          "required": true
        },
        "mime_type": {
          "type": "string",
          "description": "MIME type (e.g., 'text/plain', 'image/png', 'application/pdf')",
          "required": true
        },
        "parent_folder_id": {
          "type": "string",
          "description": "Parent folder ID (omit for root)",
          "required": false
        },
        "description": {
          "type": "string",
          "description": "File description",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Uploaded file metadata with ID"
      }
    },
    {
      "name": "google_drive_update_file",
      "description": "Update file content or metadata",
      "platform": "google_drive",
      "parameters": {
        "file_id": {
          "type": "string",
          "description": "File ID to update",
          "required": true
        },
        "name": {
          "type": "string",
          "description": "New file name",
          "required": false
        },
        "content": {
          "type": "string",
          "description": "New file content",
          "required": false
        },
        "description": {
          "type": "string",
          "description": "New description",
          "required": false
        },
        "mime_type": {
          "type": "string",
          "description": "MIME type for content update",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Updated file metadata"
      }
    },
    {
      "name": "google_drive_delete_file",
      "description": "Delete or trash a file",
      "platform": "google_drive",
      "parameters": {
        "file_id": {
          "type": "string",
          "description": "File ID to delete",
          "required": true
        },
        "permanent": {
          "type": "boolean",
          "description": "Permanently delete (vs move to trash)",
          "required": false,
          "default": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Deletion confirmation"
      }
    },
    {
      "name": "google_drive_create_folder",
      "description": "Create a new folder",
      "platform": "google_drive",
      "parameters": {
        "name": {
          "type": "string",
          "description": "Folder name",
          "required": true
        },
        "parent_folder_id": {
          "type": "string",
          "description": "Parent folder ID (omit for root)",
          "required": false
        },
        "description": {
          "type": "string",
          "description": "Folder description",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Created folder metadata with ID"
      }
    },
    {
      "name": "google_drive_move_file",
      "description": "Move file to a different folder",
      "platform": "google_drive",
      "parameters": {
        "file_id": {
          "type": "string",
          "description": "File ID to move",
          "required": true
        },
        "new_parent_folder_id": {
          "type": "string",
          "description": "Destination folder ID",
          "required": true
        },
        "remove_from_current": {
          "type": "boolean",
          "description": "Remove from current parent folders",
          "required": false,
          "default": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Updated file with new parent"
      }
    },
    {
      "name": "google_drive_copy_file",
      "description": "Create a copy of a file",
      "platform": "google_drive",
      "parameters": {
        "file_id": {
          "type": "string",
          "description": "File ID to copy",
          "required": true
        },
        "name": {
          "type": "string",
          "description": "Name for the copy",
          "required": false
        },
        "parent_folder_id": {
          "type": "string",
          "description": "Destination folder ID",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Copied file metadata"
      }
    },
    {
      "name": "google_drive_share_file",
      "description": "Share a file with users or create public link",
      "platform": "google_drive",
      "parameters": {
        "file_id": {
          "type": "string",
          "description": "File ID to share",
          "required": true
        },
        "email": {
          "type": "string",
          "description": "Email address to share with (for specific users)",
          "required": false
        },
        "role": {
          "type": "string",
          "description": "Permission role: reader, writer, commenter, or owner",
          "required": true
        },
        "type": {
          "type": "string",
          "description": "Permission type: user, group, domain, or anyone (public)",
          "required": true
        },
        "send_notification": {
          "type": "boolean",
          "description": "Send email notification",
          "required": false,
          "default": true
        },
        "message": {
          "type": "string",
          "description": "Custom message for notification",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Permission details with link"
      }
    },
    {
      "name": "google_drive_list_permissions",
      "description": "List all permissions for a file",
      "platform": "google_drive",
      "parameters": {
        "file_id": {
          "type": "string",
          "description": "File ID",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "List of permissions with users and roles"
      }
    },
    {
      "name": "google_drive_remove_permission",
      "description": "Remove sharing permission from a file",
      "platform": "google_drive",
      "parameters": {
        "file_id": {
          "type": "string",
          "description": "File ID",
          "required": true
        },
        "permission_id": {
          "type": "string",
          "description": "Permission ID to remove",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Removal confirmation"
      }
    },
    {
      "name": "google_drive_search_files",
      "description": "Advanced file search with multiple criteria",
      "platform": "google_drive",
      "parameters": {
        "name_contains": {
          "type": "string",
          "description": "File name contains text",
          "required": false
        },
        "mime_type": {
          "type": "string",
          "description": "Specific MIME type",
          "required": false
        },
        "modified_after": {
          "type": "string",
          "description": "Modified after date (ISO 8601)",
          "required": false
        },
        "modified_before": {
          "type": "string",
          "description": "Modified before date (ISO 8601)",
          "required": false
        },
        "owner_email": {
          "type": "string",
          "description": "Owner email address",
          "required": false
        },
        "shared_with_me": {
          "type": "boolean",
          "description": "Files shared with me",
          "required": false
        },
        "starred": {
          "type": "boolean",
          "description": "Starred files only",
          "required": false
        }
      },
      "returns": {
        "type": "object",
        "description": "Search results with file list"
      }
    },
    {
      "name": "google_drive_export_file",
      "description": "Export Google Docs/Sheets/Slides to different format",
      "platform": "google_drive",
      "parameters": {
        "file_id": {
          "type": "string",
          "description": "Google file ID to export",
          "required": true
        },
        "mime_type": {
          "type": "string",
          "description": "Export format (PDF, DOCX, XLSX, PPTX, etc.)",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Exported file content"
      }
    },
    {
      "name": "google_drive_get_storage_quota",
      "description": "Get Drive storage usage and quota information",
      "platform": "google_drive",
      "parameters": {},
      "returns": {
        "type": "object",
        "description": "Storage usage, limit, and breakdown by type"
      }
    },
    {
      "name": "google_drive_restore_file",
      "description": "Restore a file from trash",
      "platform": "google_drive",
      "parameters": {
        "file_id": {
          "type": "string",
          "description": "File ID to restore",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Restored file metadata"
      }
    }
  ]
}
