    {
      "name": "teams_smart_daily_standup",
      "description": "Post automated daily standup message with template",
      "platform": "microsoft_teams",
      "category": "smart_bundled",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "team_id": {
          "type": "string",
          "description": "Team ID",
          "required": true
        },
        "channel_id": {
          "type": "string",
          "description": "Channel ID",
          "required": true
        },
        "standup_data": {
          "type": "object",
          "description": "Standup information with yesterday, today, blockers",
          "required": true
        },
        "mention_team": {
          "type": "boolean",
          "description": "Whether to @mention entire team",
          "required": false,
          "default": false
        }
      },
      "example": {
        "user_id": "user123",
        "team_id": "19:abc123@thread.tacv2",
        "channel_id": "19:def456@thread.tacv2",
        "standup_data": {
          "date": "2025-10-29",
          "yesterday": ["Completed API integration", "Fixed 3 bugs"],
          "today": ["Work on UI components", "Team meeting"],
          "blockers": ["Waiting on design approval"]
        },
        "mention_team": true
      }
    },
    {
      "name": "teams_smart_broadcast_announcement",
      "description": "Send announcement to multiple channels simultaneously",
      "platform": "microsoft_teams",
      "category": "smart_bundled",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "channels": {
          "type": "array",
          "description": "List of {team_id, channel_id} objects",
          "required": true
        },
        "message": {
          "type": "string",
          "description": "Announcement message (supports HTML)",
          "required": true
        },
        "importance": {
          "type": "string",
          "description": "Message importance: 'normal', 'high', 'urgent'",
          "required": false,
          "default": "high"
        },
        "delay_seconds": {
          "type": "integer",
          "description": "Delay between posts to avoid rate limiting",
          "required": false,
          "default": 2
        }
      },
      "example": {
        "user_id": "user123",
        "channels": [
          {"team_id": "19:abc123@thread.tacv2", "channel_id": "19:def456@thread.tacv2"},
          {"team_id": "19:xyz789@thread.tacv2", "channel_id": "19:uvw012@thread.tacv2"}
        ],
        "message": "<h2>System Maintenance</h2><p>Scheduled downtime on Friday 10pm-12am</p>",
        "importance": "urgent"
      }
    },
    {
      "name": "teams_smart_create_poll",
      "description": "Create a poll in a channel and collect responses",
      "platform": "microsoft_teams",
      "category": "smart_bundled",
      "priority": "medium",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "team_id": {
          "type": "string",
          "description": "Team ID",
          "required": true
        },
        "channel_id": {
          "type": "string",
          "description": "Channel ID",
          "required": true
        },
        "question": {
          "type": "string",
          "description": "Poll question",
          "required": true
        },
        "options": {
          "type": "array",
          "description": "List of poll options",
          "required": true
        },
        "allow_multiple": {
          "type": "boolean",
          "description": "Allow multiple selections",
          "required": false,
          "default": false
        }
      },
      "example": {
        "user_id": "user123",
        "team_id": "19:abc123@thread.tacv2",
        "channel_id": "19:def456@thread.tacv2",
        "question": "What time works best for sprint planning?",
        "options": ["9am", "10am", "2pm", "3pm"],
        "allow_multiple": true
      }
    },
    {
      "name": "teams_smart_meeting_summary",
      "description": "Post meeting summary with action items to channel",
