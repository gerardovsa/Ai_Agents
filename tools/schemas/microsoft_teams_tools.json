    {
      "name": "teams_send_channel_message",
      "description": "Send a message to a team channel",
      "platform": "microsoft_teams",
      "category": "basic",
      "priority": "high",
      "parameters": {
        "user_id": {
          "type": "string",
          "description": "User ID for authentication",
          "required": true
        },
        "team_id": {
          "type": "string",
          "description": "Team ID",
          "required": true
