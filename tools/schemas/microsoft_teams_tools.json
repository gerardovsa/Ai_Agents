        "message": {
          "type": "string",
          "description": "Message content (supports HTML)",
          "required": true
        },
        "importance": {
          "type": "string",
          "description": "Message importance: 'normal', 'high', 'urgent'",
          "required": false,
          "default": "normal"
        },
        "mentions": {
          "type": "array",
          "description": "List of user IDs to @mention",
          "required": false
        }
      },
      "example": {
        "user_id": "user123",
        "team_id": "19:abc123@thread.tacv2",
        "channel_id": "19:def456@thread.tacv2",
        "message": "Sprint planning meeting at 2pm today!",
        "importance": "high"
