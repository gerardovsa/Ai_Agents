          "type": "string",
          "description": "Meeting description",
          "required": false
        }
      },
      "example": {
        "user_id": "user123",
        "subject": "Sprint Planning",
        "start_time": "2025-10-29T14:00:00Z",
        "end_time": "2025-10-29T15:00:00Z",
        "attendees": ["john@company.com", "jane@company.com"]
      }
