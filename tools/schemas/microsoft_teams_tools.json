          "type": "string",
          "description": "Channel ID",
          "required": true
        },
        "meeting_title": {
          "type": "string",
          "description": "Meeting title",
          "required": true
        },
        "attendees": {
          "type": "array",
          "description": "List of attendee names",
          "required": true
        },
        "key_points": {
          "type": "array",
          "description": "Main discussion points",
          "required": true
        },
        "action_items": {
          "type": "array",
          "description": "Action items with {task, owner, due_date}",
          "required": true
        }
      },
      "example": {
        "user_id": "user123",
        "team_id": "19:abc123@thread.tacv2",
        "channel_id": "19:def456@thread.tacv2",
