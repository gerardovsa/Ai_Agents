# Vector Database Configuration Example
# Copy this to .env or add to your existing .env file

# ===== PINECONE CONFIGURATION =====
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ai-agents-vectors

# ===== OPENAI CONFIGURATION (for embeddings) =====
# If you already have this set, no need to change
OPENAI_API_KEY=your_openai_api_key_here

# ===== GOOGLE DRIVE (Optional - for full document retrieval) =====
# Only needed if you want AI to fetch complete files from Google Drive
GOOGLE_DRIVE_CREDENTIALS_PATH=path/to/service-account.json

# ===== HOW TO GET API KEYS =====

# 1. Pinecone API Key:
#    - Go to: https://www.pinecone.io/
#    - Sign up for free (Starter plan: 1 index, 100K vectors)
#    - Create a new API key in dashboard
#    - Copy key and paste above

# 2. OpenAI API Key (for embeddings):
#    - Go to: https://platform.openai.com/api-keys
#    - Create new secret key
#    - Copy key and paste above
#    - Cost: ~$0.0001 per 1K tokens (very cheap for embeddings)

# 3. Create Pinecone Index:
#    Run this command AFTER setting API keys above:
#    
#    python -c "from pinecone import Pinecone, ServerlessSpec; import os; from dotenv import load_dotenv; load_dotenv(); pc = Pinecone(api_key=os.getenv('PINECONE_API_KEY')); pc.create_index(name='ai-agents-vectors', dimension=1536, metric='cosine', spec=ServerlessSpec(cloud='aws', region='us-east-1')); print('Index created!')"

# ===== INSTALLATION =====
# Install required packages:
# pip install pinecone-client openai PyPDF2 python-docx
